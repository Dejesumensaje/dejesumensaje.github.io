---
import '../styles/f.css';
import Header from '../components/f/Header.astro';
import Footer from '../components/f/Footer.astro';
import { getLang, alternate, cleanPath, t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const defaultOgImageAlt = lang === 'es'
  ? 'William Montoya, diseñador de producto senior radicado en Medellín, Colombia'
  : 'William Montoya, Senior Product Designer based in Medellín, Colombia';

const {
  title,
  description,
  ogImage = 'https://dejesumensaje.com/assets/william-montoya.jpg',
  ogImageAlt = defaultOgImageAlt,
  ogImageWidth = 1000,
  ogImageHeight = 750,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://dejesumensaje.com');
const canonicalURL = new URL(cleanPath(Astro.url.pathname), site).href;
const enURL = new URL(alternate(Astro.url, 'en'), site).href;
const esURL = new URL(alternate(Astro.url, 'es'), site).href;
const siteURL = new URL('/', site).href;
const personID = `${siteURL}#person`;
const websiteID = `${siteURL}#website`;
const webPageID = `${canonicalURL}#webpage`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personID,
      name: 'William Montoya',
      jobTitle: 'Senior Product Designer',
      url: siteURL,
      image: 'https://dejesumensaje.com/assets/william-montoya.jpg',
      email: 'mailto:william@dejesumensaje.com',
      worksFor: { '@type': 'Organization', name: 'Globant' },
      knowsLanguage: ['es', 'en'],
      address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
      sameAs: ['https://www.linkedin.com/in/dejesumensaje/', 'https://medium.com/@dejesumensaje'],
    },
    {
      '@type': 'WebSite',
      '@id': websiteID,
      url: siteURL,
      name: 'William Montoya',
      inLanguage: ['en', 'es'],
      author: { '@id': personID },
      publisher: { '@id': personID },
    },
    {
      '@type': 'WebPage',
      '@id': webPageID,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': websiteID },
      about: { '@id': personID },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1422" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="William Montoya" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CO'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="author" content="William Montoya" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/allo-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // JS flag + the reader's saved theme, before first paint (no flash).
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WY1Y0XF6F5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-WY1Y0XF6F5');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">{t(lang, 'skip')}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // GA4 interaction events. No PII: only page/language and the clicked label.
      type Gtag = (command: 'event', name: string, params?: Record<string, unknown>) => void;
      const gtag = (window as Window & { gtag?: Gtag }).gtag;
      const track = (name: string, params: Record<string, unknown> = {}) => {
        if (!gtag) return;
        gtag('event', name, {
          page_language: document.documentElement.lang,
          page_path: location.pathname,
          transport_type: 'beacon',
          ...params,
        });
      };
      const labelOf = (el: Element | null) =>
        el?.getAttribute('data-analytics-label') ?? el?.textContent?.trim().replace(/\s+/g, ' ').slice(0, 80) ?? '';

      document.addEventListener('click', (event) => {
        if (!(event instanceof MouseEvent) || event.button !== 0) return;
        const target = event.target;
        if (!(target instanceof Element)) return;

        const themeButton = target.closest<HTMLButtonElement>('[data-theme-toggle]');
        if (themeButton) {
          const current = document.documentElement.dataset.theme
            ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          track('theme_toggle', { to_theme: current === 'dark' ? 'light' : 'dark' });
          return;
        }

        const depthButton = target.closest<HTMLButtonElement>('[data-value]');
        if (depthButton?.closest('[data-depth-toggle]')) {
          track('depth_toggle', { mode: depthButton.dataset.value ?? '' });
          return;
        }

        const languageLink = target.closest<HTMLAnchorElement>('[data-lang-switch]');
        if (languageLink) {
          track('language_switch', { to_language: languageLink.getAttribute('hreflang') ?? '' });
          return;
        }

        const tracked = target.closest<HTMLElement>('[data-analytics]');
        if (tracked) {
          const name = tracked.dataset.analytics;
          if (name) track(name, { label: labelOf(tracked) });
          return;
        }

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const href = link.href;
        if (href.startsWith('mailto:')) {
          track('email_click', { label: link.closest('header') ? 'header' : 'footer' });
          return;
        }
        if (/\.pdf(?:$|[?#])/i.test(href)) {
          track('cv_download', { label: labelOf(link) });
          return;
        }
        if (link.target === '_blank') {
          try {
            const url = new URL(href);
            if (url.origin !== location.origin) {
              track('outbound_click', { domain: url.hostname, label: labelOf(link) });
            }
          } catch {}
        }
      }, { passive: true });
    </script>

    <script>
      // One entrance per container: [data-reveal] blocks fade/rise once.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        // Reveal as soon as the block enters the reading area. A percentage
        // threshold leaves tall/partly-visible blocks (like the logo strip)
        // invisible until an extra scroll, which reads as a rendering bug.
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
