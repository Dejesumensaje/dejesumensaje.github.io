---
// Shared bridge + CTA footer used on all Astro pages.
// showBridge is turned off on the About page itself (the bridge links there).
interface Props {
  showBridge?: boolean;
}
const { showBridge = true } = Astro.props;
---

{showBridge && (
  <section class="home-bridge" aria-label="Beyond product work">
    <div class="home-bridge__inner">
      <p class="home-bridge__text">
        Beyond the work, I teach sensory thinking at Universidad de Antioquia,
        run Alucine — a project on film and culture — and use AI as a thinking
        partner that sharpens the work rather than replacing it.
      </p>
      <a href="/about.html" class="home-bridge__link">Read more about me →</a>
    </div>
  </section>
)}

<footer id="contact" class="site-cta" aria-label="Contact">
  <div class="site-cta__inner">
    <span class="site-cta__overline">
      Embedded with Deloitte through Globant · Open to conversations
    </span>
    <h2 class="site-cta__heading">Let's <br>connect.</h2>
    <a
      href="mailto:william@dejesumensaje.com?subject=Hi, William!"
      class="site-cta__email"
    >
      william@dejesumensaje.com
    </a>
    <div class="site-cta__actions">
      <a
        href="/assets/cv-william-montoya-2024-en.pdf"
        class="button-cta button-cta--light"
        download
      >
        Download Resume
      </a>
      <a
        href="https://www.linkedin.com/in/dejesumensaje/"
        target="_blank"
        rel="noopener noreferrer"
        class="button-secondary button-secondary--light"
      >
        LinkedIn ↗
      </a>
    </div>
    <div class="site-cta__social">
      <a
        href="https://medium.com/@dejesumensaje"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/assets/medium.svg" width="50" height="50" loading="lazy" alt="Medium" />
      </a>
      <a
        href="https://github.com/Dejesumensaje"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/assets/github.svg" width="50" height="50" loading="lazy" alt="GitHub" />
      </a>
    </div>
  </div>
</footer>
