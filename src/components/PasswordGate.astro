---
// Client-side gate for NDA-bound case studies.
// This is obfuscation, not real security — it only keeps the work out of
// casual view and out of search results (paired with a noindex meta on the page).
// Pair with: a `gate-locked` head script + `/password-gate.css` in the page <head>.
interface Props {
  /** Case study name shown in the unlock prompt, e.g. "Crust Upcharge Configurator". */
  caseName: string;
}
const { caseName } = Astro.props;
---

<div id="password-gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
  <div class="gate-inner">
    <span class="gate-label">Confidential · Deloitte / Globant · NDA</span>
    <p id="gate-title" class="gate-title">This case study<br>is under NDA.</p>
    <p class="gate-desc">
      Enter the password to view the {caseName} case study. If you received this
      link from William, the password is in the same message.
    </p>
    <form class="gate-form" id="gate-form" novalidate>
      <label class="sr-only" for="gate-input">Password</label>
      <input
        class="gate-input"
        type="password"
        id="gate-input"
        name="password"
        placeholder="Enter password"
        autocomplete="off"
        aria-describedby="gate-error"
        aria-invalid="false"
      />
      <button class="gate-btn" type="submit">Unlock →</button>
    </form>
    <p class="gate-error" id="gate-error" role="alert" aria-live="assertive" hidden>
      Incorrect password. Try again.
    </p>
    <div class="gate-nav">
      <a class="gate-back" href="/">Back to portfolio</a>
      <a class="gate-hint" href="mailto:william@dejesumensaje.com?subject=Access%20to%20an%20NDA%20case%20study">No password? Contact William.</a>
    </div>
  </div>
</div>

<script>
  // Courtesy gate only (noindex + sessionStorage). The password is intentionally
  // unrelated to any text visible on the site so it can't be guessed from context.
  const PASS = 'northstar-2026';
  const KEY = 'converge_auth';
  const root = document.documentElement;
  let attempts = 0;

  const reveal = () => {
    root.classList.remove('gate-locked');
    // Content was display:none while locked, so the shared scroll-reveal
    // observer never marked the above-the-fold sections visible. Reveal them now.
    document
      .querySelectorAll<HTMLElement>('.overview, .challenge, .insights, .project-summary')
      .forEach((el) => {
        el.style.transitionDelay = '0ms';
        el.classList.add('visible');
      });
    document.body.classList.add('page-reveal');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => document.body.classList.add('loaded'))
    );
  };

  if (sessionStorage.getItem(KEY) === '1') {
    reveal();
  } else {
    const form = document.getElementById('gate-form') as HTMLFormElement | null;
    const input = document.getElementById('gate-input') as HTMLInputElement | null;
    const error = document.getElementById('gate-error') as HTMLElement | null;

    input?.focus();

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input) return;
      if (input.value.trim() === PASS) {
        sessionStorage.setItem(KEY, '1');
        input.setAttribute('aria-invalid', 'false');
        if (error) error.hidden = true;
        reveal();
      } else {
        attempts += 1;
        input.setAttribute('aria-invalid', 'true');
        input.value = '';
        input.focus();
        if (error) {
          error.hidden = false;
          error.innerHTML = attempts >= 3
            ? 'Still no luck? Email <a href="mailto:william@dejesumensaje.com?subject=Access%20to%20an%20NDA%20case%20study">william@dejesumensaje.com</a> for access.'
            : 'Incorrect password. Try again.';
        }
      }
    });
  }
</script>
