---
import { getLang, t } from '../../i18n/ui';
const lang = getLang(Astro.url);
// Official marks, trimmed to their ink. Heights are tuned by eye so a
// wordmark and a crest read at the same weight (optical, not numeric).
const logos = [
  { file: 'mintic', name: 'MinTIC, Ministry of ICT of Colombia', es: 'MinTIC, Ministerio de Tecnologías de la Información y las Comunicaciones', w: 798, h: 128, show: 30 },
  { file: 'mineducacion', name: 'Ministry of Education of Colombia', es: 'Ministerio de Educación Nacional de Colombia', w: 191, h: 128, show: 38 },
  { file: 'pnud', name: 'PNUD, United Nations Development Programme', es: 'PNUD, Programa de las Naciones Unidas para el Desarrollo', w: 63, h: 128, show: 46 },
  { file: 'unal', name: 'Universidad Nacional de Colombia', w: 127, h: 128, show: 46 },
  { file: 'udea', name: 'Universidad de Antioquia', w: 98, h: 128, show: 50 },
  { file: 'globant', name: 'Globant', w: 652, h: 128, show: 24 },
  { file: 'blackboard', name: 'Blackboard', w: 910, h: 128, show: 20 },
  { file: 'deloitte', name: 'Deloitte', w: 683, h: 128, show: 22 },
  { file: 'tacobell', name: 'Taco Bell', w: 115, h: 128, show: 42 },
  { file: 'pizzahut', name: 'Pizza Hut', w: 159, h: 128, show: 40 },
];
---

<section class="logos" aria-labelledby="logos-title" data-reveal>
  <h2 id="logos-title" class="t-small t-muted wrap">{t(lang, 'logos.title')}</h2>
  <div class="reel">
    <div class="reel__track">
      {[0, 1].map((copy) => (
        <ul class="reel__list list-reset" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {logos.map((l) => (
            <li>
              <img
                src={`/assets/logos/${l.file}.webp`}
                alt={copy === 1 ? '' : (lang === 'es' && (l as { es?: string }).es) || l.name}
                width={Math.round((l.w / l.h) * l.show)}
                height={l.show}
                loading="lazy"
                decoding="async"
                style={`height:${l.show}px`}
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .logos {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-section);
  }
  /* Reel: constant, linear motion (it's ambient, not an event), faded at
     the edges, paused while you look at a logo. Two copies make the loop seamless. */
  .reel {
    max-width: calc(var(--max) + var(--grid-margin) * 2);
    margin-inline: auto;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 var(--grid-margin), #000 calc(100% - var(--grid-margin)), transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--grid-margin), #000 calc(100% - var(--grid-margin)), transparent);
  }
  .reel__track {
    display: flex;
    width: max-content;
    animation: reel 48s linear infinite;
  }
  .reel:hover .reel__track { animation-play-state: paused; }
  .reel__list {
    display: flex;
    align-items: center;
    gap: var(--space-15);
    padding-right: var(--space-15);
  }
  .reel__list li { display: flex; align-items: center; min-height: 52px; flex: none; }
  .reel__list img {
    width: auto;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.62;
    transition: filter 200ms ease, opacity 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .reel__list li:hover img { filter: none; opacity: 1; }
  }
  @keyframes reel { to { transform: translateX(-50%); } }
  /* Dark: marks are mostly dark ink, so they are inverted to light grey;
     on hover they brighten instead of turning to (unreadable) full color. */
  :global(:root[data-theme='dark']) .reel__list img { filter: grayscale(1) invert(1) brightness(1.15); opacity: 0.7; }
  :global(:root[data-theme='dark']) .reel__list li:hover img { filter: grayscale(1) invert(1) brightness(1.3); opacity: 1; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .reel__list img { filter: grayscale(1) invert(1) brightness(1.15); opacity: 0.7; }
    :global(:root:not([data-theme='light'])) .reel__list li:hover img { filter: grayscale(1) invert(1) brightness(1.3); opacity: 1; }
  }

  @media (max-width: 759px) {
    .logos { gap: var(--space-6); }
    .reel__list { gap: var(--space-11); padding-right: var(--space-11); }
    .reel__list img { transform: scale(0.82); }
    .reel__track { animation-duration: 36s; }
  }
  /* Reduced motion: a still, wrapped wall of logos instead of a reel. */
  @media (prefers-reduced-motion: reduce) {
    .reel { mask-image: none; -webkit-mask-image: none; padding-inline: var(--grid-margin); }
    .reel__track { animation: none; width: auto; }
    .reel__list { flex-wrap: wrap; gap: var(--space-8) var(--space-11); padding: 0; }
    .reel__list[aria-hidden] { display: none; }
  }
</style>
