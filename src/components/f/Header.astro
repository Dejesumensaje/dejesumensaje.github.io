---
import Logo from './Logo.astro';
import { getLang, localize, alternate, t } from '../../i18n/ui';

const lang = getLang(Astro.url);
const path = Astro.url.pathname.replace(/^\/es(\/|\.html$|$)/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
// Home is the front page, not "Work": nothing is marked there. Case studies
// live inside Work, so they mark it.
const isHome = path === '/' || path === '/index' || path === '/404';
const current =
  path === '/about' ? 'about' : path === '/resume' ? 'resume' : isHome ? null : 'work';

const links = [
  { id: 'work', label: t(lang, 'nav.work'), href: localize(lang, '/#work') },
  { id: 'about', label: t(lang, 'nav.about'), href: localize(lang, '/about.html') },
  { id: 'resume', label: t(lang, 'nav.resume'), href: localize(lang, '/resume.html') },
];
const other = lang === 'es' ? 'en' : 'es';
const switchHref = alternate(Astro.url, other);
const email = 'william@dejesumensaje.com';
const subject = encodeURIComponent(t(lang, 'hola.subject'));
const home = localize(lang, '/');
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href={home} aria-label={t(lang, 'nav.home')}>
      <Logo size={32} />
      <span>William Montoya</span>
    </a>

    <nav class="nav__links" aria-label={t(lang, 'nav.primary')}>
      <ul class="list-reset" role="list">
        {links.map((l) => (
          <li>
            <a class="nav__link" href={l.href} aria-current={current === l.id ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <button class="theme-btn" type="button" data-theme-toggle data-to-dark={t(lang, 'theme.toDark')} data-to-light={t(lang, 'theme.toLight')} aria-label={t(lang, 'theme.toDark')}>
        <svg class="theme-btn__moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        <svg class="theme-btn__sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
      </button>
      <a class="nav__lang" href={switchHref} hreflang={other} lang={other} aria-label={t(lang, 'nav.switchLabel')}>{other.toUpperCase()}</a>
      <a class="btn btn--primary btn--compact hola" href={`mailto:${email}?subject=${subject}`}>
        <span set:html={t(lang, 'hola')} /><span class="hola__hand" aria-hidden="true">👋</span>
      </a>
    </nav>

    <div class="nav__mobile">
      <button class="theme-btn theme-btn--mobile" type="button" data-theme-toggle data-to-dark={t(lang, 'theme.toDark')} data-to-light={t(lang, 'theme.toLight')} aria-label={t(lang, 'theme.toDark')}>
        <svg class="theme-btn__moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        <svg class="theme-btn__sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
      </button>
    <button
      class="nav__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span class="sr-only">{t(lang, 'nav.openMenu')}</span>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 6h14M2 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="menu"
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, 'nav.menu')}
  hidden
  data-menu
>
  <div class="menu__top">
    <div class="menu__bar">
      <a class="nav__brand" href={home} aria-label={t(lang, 'nav.home')}>
        <Logo size={28} />
        <span>William Montoya</span>
      </a>
      <button class="nav__menu-btn" type="button" data-menu-close>
        <span class="sr-only">{t(lang, 'nav.closeMenu')}</span>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul class="menu__links list-reset" role="list">
      {links.map((l) => (
        <li>
          <a class="menu__link" href={l.href} aria-current={current === l.id ? 'page' : undefined}>
            <span>{l.label}</span>
            {current === l.id && <small>{t(lang, 'nav.here')}</small>}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="menu__bottom">
    <p class="t-small">
      {t(lang, 'nav.available')}<br />
      <span class="t-muted">{email}</span>
    </p>
    <div class="menu__actions">
      <a class="btn btn--primary menu__cta" href={`mailto:${email}?subject=${subject}`}><span set:html={t(lang, 'hola')} /></a>
      <a class="btn btn--outline menu__lang" href={switchHref} hreflang={other} lang={other}>{t(lang, 'nav.switch')}</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    transition: transform 280ms var(--ease-out), box-shadow 200ms ease;
  }
  /* Hides while reading down, returns on the first scroll up */
  .nav[data-hidden='true'] { transform: translateY(-100%); }
  .nav[data-scrolled='true'] { box-shadow: 0 1px 0 var(--line); }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 24px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: var(--text-body);
    min-height: 44px;
  }
  .nav__links { display: flex; align-items: center; gap: 40px; }
  .nav__links ul { display: flex; gap: 40px; }
  .nav__link {
    font-weight: 500;
    padding-block: 10px;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition: text-decoration-color 160ms ease;
  }
  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current='page'] { text-decoration-color: currentColor; }

  /* Say ¡Hola!: the button turns accent blue and a hand appears at its
     left corner, waving right away. No delay, no bounce. */
  .hola {
    gap: 0; /* the hand floats outside; it must not add spacing */
    overflow: visible;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .hola__hand {
    position: absolute;
    left: -14px;
    top: -16px;
    font-size: 22px;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px) scale(0.9);
    transform-origin: 70% 90%; /* the wrist */
    transition: opacity 150ms ease, transform 150ms var(--ease-out);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hola:hover,
    .hola:focus-visible { background: var(--accent); }
    .hola:hover .hola__hand,
    .hola:focus-visible .hola__hand {
      opacity: 1;
      transform: none;
      animation: wave 700ms var(--ease-in-out) 1;
    }
  }
  @keyframes wave {
    0%, 100% { rotate: 0deg; }
    20% { rotate: 16deg; }
    40% { rotate: -8deg; }
    60% { rotate: 12deg; }
    80% { rotate: -4deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hola__hand { transform: none !important; animation: none !important; transition: opacity 150ms ease !important; }
  }

  /* Language switch: quiet, two letters, before the CTA */
  .nav__lang {
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 10px 2px;
    margin-right: -16px;
    transition: color 160ms ease;
  }
  .nav__lang:hover, .nav__lang:focus-visible { color: var(--ink); }

  /* Theme switch: moon in light mode, sun in dark; follows the OS until the
     reader picks, then remembers the pick. */
  .theme-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -16px;
    border-radius: var(--radius-pill);
    color: var(--muted);
    transition: color 160ms ease, transform 160ms var(--ease-out);
  }
  .theme-btn:hover, .theme-btn:focus-visible { color: var(--ink); }
  .theme-btn:active { transform: scale(0.94); }
  .theme-btn__sun { display: none; }
  :global(:root[data-theme='dark']) .theme-btn__sun { display: block; }
  :global(:root[data-theme='dark']) .theme-btn__moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-btn__sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme-btn__moon { display: none; }
  }
  .nav__mobile { display: none; align-items: center; gap: 4px; }
  .theme-btn--mobile { width: 44px; height: 44px; margin: 0; }

  .nav__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 160ms var(--ease-out);
  }
  .nav__menu-btn:active { transform: scale(0.94); }

  @media (max-width: 759px) {
    .nav__inner { padding-block: 16px; }
    .nav__links { display: none; }
    .nav__mobile { display: flex; }
    .nav__menu-btn { display: grid; }
  }

  /* ---------- Mobile menu: full-screen sheet ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateY(-100%);
    transition: transform 240ms var(--ease-drawer);
  }
  .menu[hidden] { display: none; }
  .menu.is-open { transform: none; }
  /* Exit is faster than the entrance */
  .menu.is-closing { transition-duration: 200ms; }

  .menu__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px var(--grid-margin);
  }
  .menu__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 48px var(--grid-margin) 0;
  }
  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 8px;
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
  }
  .menu__link small {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
  }
  .menu__link[aria-current='page'] { color: var(--accent); }
  .menu__bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px var(--grid-margin) max(32px, env(safe-area-inset-bottom));
  }
  .menu__actions { display: flex; flex-direction: column; gap: 12px; }
  .menu__cta, .menu__lang { width: 100%; padding-block: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .nav, .menu { transition: opacity 150ms ease; transform: none !important; }
    .menu { opacity: 0; }
    .menu.is-open { opacity: 1; }
  }
</style>

<script>
  // Theme: the saved choice (set before paint in Layout) or the OS setting.
  {
    const root = document.documentElement;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));
    const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);
    const label = () => buttons.forEach((b) => b.setAttribute('aria-label', (isDark() ? b.dataset.toLight : b.dataset.toDark) ?? ''));
    const metas = Array.from(document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]'));
    const set = (mode: 'dark' | 'light') => {
      root.dataset.theme = mode;
      try { localStorage.setItem('theme', mode); } catch {}
      metas.forEach((m) => m.setAttribute('content', mode === 'dark' ? '#0e1422' : '#ffffff'));
      label();
    };
    buttons.forEach((b) => b.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // A short crossfade of the whole page: the change reads as one gesture.
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !still) doc.startViewTransition(() => set(next));
      else set(next);
    }));
    mq.addEventListener('change', label);
    label();
  }

  // Sticky nav: hide on scroll down, show on scroll up.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      nav.dataset.scrolled = String(y > 8);
      // Ignore tiny jitters; never hide near the top.
      if (Math.abs(y - lastY) > 6) {
        nav.dataset.hidden = String(y > lastY && y > 240);
        lastY = y;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
    }, { passive: true });
    // Keyboard users tabbing into the nav always see it.
    nav.addEventListener('focusin', () => { nav.dataset.hidden = 'false'; });
  }

  // Mobile menu: locks scroll, traps focus, returns focus to the opener.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closer = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && opener && closer) {
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { close(); return; }
      if (e.key !== 'Tab') return;
      const f = focusables();
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    };

    const open = () => {
      menu.hidden = false;
      menu.classList.remove('is-closing');
      document.documentElement.style.overflow = 'hidden';
      opener.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
      closer.focus({ preventScroll: true });
      document.addEventListener('keydown', onKey);
    };
    const close = () => {
      menu.classList.add('is-closing');
      menu.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      opener.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKey);
      opener.focus({ preventScroll: true });
      const done = () => { if (!menu.classList.contains('is-open')) menu.hidden = true; };
      menu.addEventListener('transitionend', done, { once: true });
      setTimeout(done, 260);
    };
    opener.addEventListener('click', open);
    closer.addEventListener('click', close);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    window.matchMedia('(min-width: 760px)').addEventListener('change', (m) => { if (m.matches && !menu.hidden) close(); });
  }
</script>
