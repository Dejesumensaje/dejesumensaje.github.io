---
// Before/after comparison of two captures of the same screen. A native range
// input drives the split, so it works with a pointer, touch and the keyboard.
// Without JS the split stays in the middle.
interface Shot { src: string; alt: string }
interface Props {
  before: Shot;
  after: Shot;
  width: number;
  height: number;
  labels: { before: string; after: string };
  rangeLabel: string;
}
const { before, after, width, height, labels, rangeLabel } = Astro.props;
---

<div class="ba" style={`aspect-ratio:${width}/${height}`} data-ba>
  <img class="ba__img" src={before.src} alt={before.alt} width={width} height={height} loading="lazy" decoding="async" />
  <div class="ba__after">
    <img class="ba__img" src={after.src} alt={after.alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <span class="ba__line" aria-hidden="true"><span class="ba__knob"></span></span>
  <span class="ba__tag ba__tag--before t-small" aria-hidden="true">{labels.before}</span>
  <span class="ba__tag ba__tag--after t-small" aria-hidden="true">{labels.after}</span>
  <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={rangeLabel} />
</div>

<style>
  .ba {
    --p: 50%;
    position: relative;
    /* The whole comparison fits in the viewport: width follows the height left under the header */
    width: min(100%, calc((100svh - var(--space-20)) * 1.406));
    align-self: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 var(--hairline) var(--line);
    background: var(--surface);
    isolation: isolate;
    user-select: none;
  }
  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: brightness(var(--shot-dim));
  }
  .ba__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--p));
  }
  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--p);
    width: 2px;
    translate: -50% 0;
    background: var(--ink);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    height: 32px;
    translate: -50% -50%;
    border-radius: var(--radius-pill);
    background: var(--ink);
    box-shadow: 0 4px 12px -4px rgba(23, 24, 26, 0.4);
  }
  .ba__knob::before,
  .ba__knob::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    translate: 0 -50%;
    border-block: 5px solid transparent;
  }
  .ba__knob::before { left: 7px; border-right: 6px solid var(--on-ink); }
  .ba__knob::after { right: 7px; border-left: 6px solid var(--on-ink); }
  .ba__tag {
    position: absolute;
    top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    pointer-events: none;
  }
  .ba__tag--before { left: var(--space-3); }
  .ba__tag--after { right: var(--space-3); }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .ba:has(.ba__range:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 759px) {
    .ba__knob { width: 28px; height: 28px; }
    .ba__tag { top: var(--space-2); padding: 0 var(--space-2); }
    .ba__tag--before { left: var(--space-2); }
    .ba__tag--after { right: var(--space-2); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;
    const set = () => box.style.setProperty('--p', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
