---
// A prototype's history as dated stops over one browser frame. The stops are
// tabs: picking one swaps the capture in place, so what moved between versions
// stays where the eye already is. Arrow keys move between stops. Without JS
// the first stop shows.
export interface Stop {
  date: string;
  phase: string;
  title: string;
  note: string;
  src: string;
  alt: string;
}
interface Props {
  id: string;
  stops: Stop[];
  label: string;
  width: number;
  height: number;
}
const { id, stops, label, width, height } = Astro.props;
---

<div class="evo" data-evo>
  <div class="evo__steps" role="tablist" aria-label={label}>
    {stops.map((s, i) => (
      <button
        class="evo__step"
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-controls={`${id}-panel`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-i={i}
      >
        <span class="evo__date t-small">{s.date}</span>
        <span class="evo__title">{s.title}</span>
      </button>
    ))}
  </div>

  <div class="evo__panel" role="tabpanel" id={`${id}-panel`} aria-labelledby={`${id}-tab-0`}>
    <div class="evo__frame">
      <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="evo__shots" style={`aspect-ratio:${width}/${height}`}>
        {stops.map((s, i) => (
          <img
            class:list={['evo__shot', { 'is-active': i === 0 }]}
            src={s.src}
            alt={s.alt}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
            data-i={i}
          />
        ))}
      </div>
    </div>
    {stops.map((s, i) => (
      <div class:list={['evo__note measure', { 'is-active': i === 0 }]} data-i={i}>
        <p class="t-small evo__phase">{s.phase}</p>
        <p>{s.note}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .evo { display: flex; flex-direction: column; gap: var(--space-6); }
  .evo__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4) var(--gutter);
  }
  .evo__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) 0 0;
    border: 0;
    border-top: 2px solid var(--line);
    background: none;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .evo__step[aria-selected='true'],
  .evo__step.is-past { border-top-color: var(--ink); }
  .evo__step[aria-selected='true'] { color: var(--ink); }
  .evo__step:hover { color: var(--ink); }
  .evo__step:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .evo__title { font-family: var(--font-display); font-weight: var(--weight-h3); line-height: 1.3; text-wrap: balance; }
  .evo__frame {
    overflow: hidden;
    border-radius: 10px;
    background: var(--chrome);
    box-shadow:
      0 1px 2px rgba(23, 24, 26, 0.06),
      0 12px 32px -8px rgba(23, 24, 26, 0.16),
      0 0 0 1px rgba(23, 24, 26, 0.06);
  }
  .evo__shots { display: grid; }
  .evo__shot {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    filter: brightness(var(--shot-dim));
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms var(--ease-out), visibility 0s 200ms;
  }
  .evo__shot.is-active { opacity: 1; visibility: visible; transition: opacity 200ms var(--ease-out); }
  .evo__note { display: none; margin-top: var(--space-6); color: var(--muted); }
  .evo__note.is-active { display: flex; flex-direction: column; gap: var(--space-1); }
  .evo__phase { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .evo__shot, .evo__shot.is-active, .evo__step { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-evo]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const parts = [...root.querySelectorAll<HTMLElement>('.evo__shot, .evo__note')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
        t.classList.toggle('is-past', j < i);
      });
      parts.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === i));
      panel.setAttribute('aria-labelledby', tabs[i].id);
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: n - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select((to + n) % n, true);
      });
    });
  });
</script>
