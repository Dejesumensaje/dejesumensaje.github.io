---
interface Section {
  id: string;
  label: string;
}
interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
---

<nav data-case-toc aria-label="On this page">
  <span class="toc-label">On this page</span>
  {sections.map(s => (
    <a href={`#${s.id}`} class="toc-link">{s.label}</a>
  ))}
</nav>

<style>
  /* ── Mobile: sticky horizontal chip bar ─────────────── */
  @media (max-width: 1023px) {
    nav {
      position: sticky;
      top: 0;
      z-index: 90;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.375rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0.6rem var(--gutter);
      background: rgba(250, 250, 248, 0.92);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    nav::-webkit-scrollbar { display: none; }

    .toc-label {
      display: none;
    }

    .toc-link {
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      font-weight: 600;
      color: rgba(15, 15, 15, 0.65);
      text-decoration: none;
      white-space: nowrap;
      padding: 0.35rem 0.75rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 99px;
      flex-shrink: 0;
    }

    .toc-link.is-active {
      color: #fff;
      background: var(--ink);
      border-color: var(--ink);
    }
  }

  @media (min-width: 1024px) {
    nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      right: 1.75rem;
      width: 136px;
      z-index: 90;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    nav.is-visible {
      opacity: 1;
      pointer-events: auto;
    }

    .toc-label {
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: rgba(15, 15, 15, 0.65);
      margin-bottom: 0.5rem;
      transition: color 0.25s ease;
    }

    nav:hover .toc-label {
      color: rgba(15, 15, 15, 0.7);
    }

    .toc-link {
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      font-weight: 500;
      color: rgba(15, 15, 15, 0.65);
      text-decoration: none;
      display: block;
      padding: 0.4rem 0 0.4rem 0.625rem;
      border-left: 2px solid transparent;
      transition: color 0.2s ease, border-color 0.2s ease;
      line-height: 1.35;
    }

    nav:hover .toc-link {
      color: rgba(15, 15, 15, 0.7);
    }

    .toc-link.is-active {
      color: var(--ink);
      border-left-color: var(--ink);
      font-weight: 600;
    }

    nav:hover .toc-link.is-active,
    nav:hover .toc-link:hover {
      color: var(--ink);
      border-left-color: var(--ink);
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('[data-case-toc]');
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    const sections = links
      .map(l => document.getElementById(l.getAttribute('href')!.replace('#', '')))
      .filter((s): s is HTMLElement => s !== null);

    // ── Active state ──────────────────────────────────
    const horizontal = window.matchMedia('(max-width: 1023px)');
    const setActive = (id: string) => {
      links.forEach(l => {
        const active = l.getAttribute('href') === `#${id}`;
        const wasActive = l.classList.contains('is-active');
        l.classList.toggle('is-active', active);
        active ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current');
        // On the mobile chip bar, keep the active chip in view.
        if (active && !wasActive && horizontal.matches) {
          l.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        }
      });
    };

    const update = () => {
      const trigger = window.innerHeight * 0.4;
      let current = sections[0]?.id ?? '';
      for (const s of sections) {
        if (s.getBoundingClientRect().top < trigger) current = s.id;
      }
      setActive(current);
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    update();

    // ── Visibility: hide during hero and once the end-of-page
    //    blocks (case nav / footer) scroll into view ──────
    const hero = document.getElementById('hero-case');
    const blockers = [
      document.querySelector<HTMLElement>('.case-nav'),
      document.querySelector<HTMLElement>('footer'),
    ].filter((el): el is HTMLElement => el !== null);

    let heroVisible = hero !== null;
    const endVisible = new Set<Element>();
    const applyVisibility = () => {
      toc.classList.toggle('is-visible', !heroVisible && endVisible.size === 0);
    };

    if (hero) {
      new IntersectionObserver(
        ([entry]) => { heroVisible = entry.isIntersecting; applyVisibility(); },
        { threshold: 0 }
      ).observe(hero);
    }

    if (blockers.length > 0) {
      const endObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => e.isIntersecting ? endVisible.add(e.target) : endVisible.delete(e.target));
          applyVisibility();
        },
        { threshold: 0 }
      );
      blockers.forEach(el => endObserver.observe(el));
    }

    applyVisibility();
  }
</script>
