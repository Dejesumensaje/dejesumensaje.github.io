---
// Prev / next navigation between case studies, derived from projects.ts so the
// order stays in sync with the work list. Wraps around (circular) in both directions.
import { projects } from '../data/projects';
interface Props { slug: string; }
const { slug } = Astro.props;
const i = projects.findIndex((p) => p.slug === slug);
const prev = projects[(i - 1 + projects.length) % projects.length];
const next = projects[(i + 1) % projects.length];
---

<nav class="case-nav" aria-label="Case study navigation">
  <a class="case-nav__link case-nav__link--prev" href={prev.href}>
    <span class="case-nav__label">← Previous</span>
    <span class="case-nav__title">{prev.title}</span>
  </a>
  <a class="case-nav__link case-nav__link--next" href={next.href}>
    <span class="case-nav__label">Next case study →</span>
    <span class="case-nav__title">{next.title}</span>
  </a>
</nav>

<style>
  .case-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ink-faint);
    border-top: 1px solid var(--ink-faint);
    border-bottom: 1px solid var(--ink-faint);
  }

  .case-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(2rem, 4vw, 3rem) var(--gutter);
    background: var(--canvas);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .case-nav__link--next { align-items: flex-start; }

  .case-nav__link:hover { background: var(--white); }

  .case-nav__label {
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
  }

  .case-nav__title {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    max-width: 28ch;
    transition: color 0.2s ease;
  }

  .case-nav__link:hover .case-nav__title { color: var(--ocean); }

  @media (min-width: 768px) {
    .case-nav { grid-template-columns: 1fr 1fr; }
    .case-nav__link--next { align-items: flex-end; text-align: right; }
    .case-nav__link--next .case-nav__title { text-align: right; }
  }
</style>
