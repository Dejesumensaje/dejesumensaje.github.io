---
import CaseLayout from '../layouts/CaseLayout.astro';
import CaseHeader from '../components/f/CaseHeader.astro';
import NextStory from '../components/f/NextStory.astro';

const facts = [
  { k: 'Role', v: 'User research, information architecture, prototyping, testing, project management' },
  { k: 'Date', v: '2020 – 2021' },
  { k: 'Team', v: 'Camilo Beltrán, development lead\nCatalina Mendoza, visual and interaction design\nNatalia Torres, visual design' },
];
const overview = [
  { k: 'Challenge', v: 'Reorganize a 17-year-old national platform where 81,000 resources were buried and only one content line saw real use.' },
  { k: 'Contribution', v: 'User research, information architecture, prototyping, testing and cross-functional product direction.' },
  { k: 'Constraints', v: '81,000 resources, 70+ microsites, multiple audiences and strong internal resistance to change.' },
  { k: 'Outcome', v: 'Content downloads up 81% in year one, 60,000 monthly users on the content section, and stakeholder buy-in for ongoing iteration.' },
];
const numbers = [
  { v: '81,000', k: 'educational resources' },
  { v: '70+', k: 'microsites' },
  { v: '3.5M', k: 'users at the pandemic peak' },
];
const insights = [
  'Many of the most prominent spaces were unused and outdated. Useful content was buried under layers of unnecessary clicks.',
  'Most users bounced as soon as they downloaded the resource they needed to prepare a class, only coming back months or years later.',
  'Only one content offering saw real use: Contenidos para Aprender, a collection of resources for teaching and building basic skills.',
];
const lessons = [
  { t: 'Internal users count too', b: "Changing a 17-year-old public platform meant bringing Colombia Aprende's staff and Ministry teams into the process early, together with teachers." },
  { t: 'Evidence breaks resistance', b: 'Presenting the heuristic audit, the EAFIT expert panel and real usage data to leadership was what unlocked buy-in for the redesign.' },
  { t: 'Keep it simple', b: 'With a website as large and old as Colombia Aprende, you have to give yourself permission to make it a little smaller, to narrow the focus.' },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---

<CaseLayout
  title="Simplifying Colombia Aprende — William Montoya"
  description="How do you transform a 17-year-old national platform with 3.5 million users to improve discovery, retention and conversion?"
  ogImage="https://dejesumensaje.com/assets/colombia-aprende-mockup.png"
  ogImageAlt="Colombia Aprende platform redesign"
  ogImageWidth={1026}
  ogImageHeight={822}
  readFull="8 min"
  readTldr="1 min"
>
  <CaseHeader
    lead="Simplifying Colombia Aprende for"
    accent="inclusion and equity"
    question="How do you transform a 17-year-old national platform with 3.5 million users to improve discovery, retention and conversion?"
    facts={[...facts, { k: 'Link', v: 'colombiaaprende.edu.co', href: 'https://colombiaaprende.edu.co' }]}
    overview={overview}
    readFull="8 min"
    readTldr="1 min"
  />

  <!-- Lead figure -->
  <figure class="figure figure--lead wrap" data-reveal>
    <div class="stage" style="aspect-ratio:1296/640">
      <div class="browser" style={`left:${pct(148, 1296)};top:${pct(56, 640)};width:${pct(1000, 1296)}`}>
        <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <img src="/assets/colombia-aprende-imagen.webp" width="1400" height="700" alt="The redesigned Colombia Aprende home: search, featured content and news for teachers." fetchpriority="high" />
      </div>
    </div>
  </figure>

  <!-- In numbers -->
  <section class="chapter chapter--section wrap" aria-labelledby="ch-numbers" data-reveal>
    <div class="split">
      <h2 id="ch-numbers" class="t-h3 split__label">In numbers</h2>
      <div class="columns3 numbers split__body">
        {numbers.map((n) => (
          <div><p class="t-display">{n.v}</p><p class="t-muted">{n.k}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Background -->
  <section class="chapter wrap" aria-labelledby="ch-background" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-background" class="t-h3 split__label">Background</h2>
      <div class="prose measure split__body">
        <p>Colombia Aprende was a website too big and too complex. It looked dated and performed poorly.</p>
        <p>With 81,000 educational resources, more than 70 microsites, five sections and five sub-sites for every audience of Colombia's educational community, the whole experience was messy and lacked intention.</p>
        <p>Before I joined, the team didn't have a connection with their users. The portal was full of meaningful resources, but the process of finding and using them was convoluted.</p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="chapter chapter--tight wrap" aria-labelledby="ch-process" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-process" class="t-h3 split__label">Process</h2>
      <div class="chapter__stack split__body">
        <div class="prose measure">
          <p>At first, the stakeholders weren't keen on redesigning Colombia Aprende, so we began with a heuristic evaluation of the old platform to audit its usability problems.</p>
          <p>After gathering feedback from 20 teachers and school administrators from around the country, we validated our findings with an external panel of experts at Universidad EAFIT.</p>
        </div>
        <div class="columns3">
          {insights.map((t, i) => (
            <div><p class="t-small t-muted">Insight 0{i + 1}</p><p class="insight">{t}</p></div>
          ))}
        </div>
        <div class="prose measure">
          <p>By this stage it was clear the portal needed a full rebuild so teachers across the country could actually find and use its catalog.</p>
          <p>To do it, we mixed the Double Diamond framework with Lean UX.</p>
        </div>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage stage--auto" style="aspect-ratio:1296/520">
      <div class="diamonds">
        {[
          { phase: 'Research', l: 'Discover', r: 'Define', steps: ['User research', 'Problem statement', 'User stories'] },
          { phase: 'Create', l: 'Ideate', r: 'Implement', steps: ['Lean UX and content collections', 'Prototypes and testing', 'Development'] },
        ].map((d) => (
          <div class="diamond">
            <div class="diamond__shape">
              <span class="t-small t-muted diamond__phase diamond__phase--l">{d.l}</span>
              <span class="t-small t-muted diamond__phase diamond__phase--r">{d.r}</span>
              {d.steps.map((s) => <span class="t-small diamond__step">{s}</span>)}
            </div>
            <p class="t-h3">{d.phase}</p>
          </div>
        ))}
      </div>
    </div>
    <figcaption class="t-small">The process: Double Diamond with Lean UX</figcaption>
  </figure>

  <!-- Understanding the challenge -->
  <section class="chapter wrap" aria-labelledby="ch-understanding" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-understanding" class="t-h3 split__label">The challenge</h2>
      <div class="chapter__stack split__body" style="gap:var(--space-9)">
        <div class="prose measure">
          <p>The main barrier to transforming Colombia Aprende was internal. The team and stakeholders across the Education Ministry were reluctant to change a platform that had existed for more than 17 years.</p>
          <p>So while we ran research interviews with our main audience, public-sector teachers, we also ran workshops, empathy maps and value-proposition canvases with almost every area of the Ministry.</p>
        </div>
        <div class="measure" style="display:flex;flex-direction:column;gap:var(--space-3)">
          <p class="t-small t-muted">Our research included</p>
          <ul class="dash-list list-reset" role="list">
            <li>Uncovering pain points of both end users and internal users.</li>
            <li>Mapping the goals of everyone involved, from administrators to teachers and school leaders.</li>
            <li>Auditing the content and benchmarking similar platforms around the world.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Setting the road -->
  <section class="chapter chapter--tight wrap" aria-labelledby="ch-road" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-road" class="t-h3 split__label">Setting the road</h2>
      <div class="chapter__stack split__body">
        <p class="measure">After filtering the research, we centered the redesign on content collections: a new service organizing educational resources by topic, audience and format.</p>
        <p class="t-h2 pull">In a content collection, users don't see individual resources. It's more like a kit the team publishes to achieve a specific goal.</p>
        <div class="prose measure">
          <p>By brainstorming and card-sorting, we created a new sitemap with the team, where the content section was the most important and visible through the whole navigation structure.</p>
        </div>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage" style="aspect-ratio:1296/680">
      <img class="flat" src="/assets/userflow-colombiaaprende.webp" width="1400" height="779" loading="lazy" alt="User flow for the new Colombia Aprende, from the home page through content collections to a single resource." style={`left:${pct(148, 1296)};top:${pct(62, 680)};width:${pct(1000, 1296)}`} />
    </div>
    <figcaption class="t-small">The first version of the new user flow (diagram in Spanish)</figcaption>
  </figure>

  <!-- Prototyping and testing -->
  <section class="chapter chapter--tight wrap" aria-labelledby="ch-proto" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-proto" class="t-h3 split__label">Prototyping and testing</h2>
      <div class="prose measure split__body">
        <p>Once we defined the new visual identity, we created the first mockups in Figma and published them on InVision to gather feedback and validate the user flow.</p>
        <p>That's how we spotted flaws in our original content collections, for example the inability to arrange and filter resources.</p>
        <p>We built new categories with Colombia Aprende's content management staff, based on teacher feedback, and ran A/B testing to decide which options made it into the final interface.</p>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-reveal>
    <div class="stage" style="aspect-ratio:1296/680">
      <div class="browser" style={`left:${pct(268, 1296)};top:${pct(38, 680)};width:${pct(760, 1296)}`}>
        <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <img src="/assets/mockup-aprender-digital.webp" width="1400" height="1061" loading="lazy" alt="The final interface: a content collection page with filters and resources." />
      </div>
    </div>
    <figcaption class="t-small">The final interface, refined through A/B testing (in Spanish)</figcaption>
  </figure>

  <!-- Results -->
  <section class="chapter chapter--section wrap" aria-labelledby="ch-results" data-reveal>
    <div class="split">
      <h2 id="ch-results" class="t-h3 split__label">Results</h2>
      <div class="prose measure split__body">
        <p>In the year after the October 2020 launch, content downloads grew 81%. Grouping resources into collections surfaced material beyond Contenidos para Aprender, the only offering teachers used before, bringing the content section to roughly 60,000 monthly users.</p>
        <p>The user-centered process also ended internal resistance, allowing the team to keep iterating after launch.</p>
      </div>
    </div>
  </section>

  <!-- Lessons -->
  <section class="chapter chapter--section wrap" aria-labelledby="ch-lessons" data-reveal>
    <div class="split">
      <h2 id="ch-lessons" class="t-h3 split__label">Lessons</h2>
      <div class="split__body" style="display:flex;flex-direction:column;gap:var(--space-10)">
        <div class="columns3">
          {lessons.map((l) => (
            <div><h3 class="t-h3">{l.t}</h3><p class="t-muted">{l.b}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <NextStory current="/colombia-aprende" />
</CaseLayout>
