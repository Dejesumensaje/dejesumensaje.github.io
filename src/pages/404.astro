---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — William Montoya"
  description="This page doesn't exist. Head back to the work or get in touch."
  footerBridge={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main id="main-content">
    <section class="notfound" aria-labelledby="notfound-heading">
      <p class="notfound-code" aria-hidden="true">404</p>
      <h1 id="notfound-heading">This page doesn't exist.</h1>
      <p class="notfound-desc">
        The link may be outdated, or the page moved. Everything worth seeing
        is one click away:
      </p>
      <div class="notfound-actions">
        <a href="/#work" class="btn btn--primary">View work</a>
        <a href="/about.html" class="btn btn--ghost">About me</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
    display: grid;
    align-content: center;
    justify-items: start;
    max-width: var(--layout-width);
    margin: 0 auto;
    padding: calc(var(--space-unit) * 12) var(--gutter) var(--section-pad);
  }

  .notfound-code {
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }

  .notfound h1 {
    font-size: var(--text-h1);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .notfound-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    color: var(--ink-muted);
    max-width: 32rem;
    margin-bottom: 2rem;
  }

  .notfound-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
