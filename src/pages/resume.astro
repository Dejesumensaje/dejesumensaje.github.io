---
import Layout from '../layouts/Layout.astro';
import RiseTitle from '../components/f/RiseTitle.astro';

// Keep in sync with the PDF in public/assets (generated from this same content).
const pdf = '/assets/cv-william-montoya-2026-en.pdf';

const experience = [
  {
    role: 'Senior Product Designer',
    org: 'Deloitte · Converge, via Globant',
    when: 'Feb 2024 – present',
    points: [
      'Own design for the Pizza Hut and US grocery retail platforms, the two Converge products billing at Deloitte, shipping fast iterations on client and end-user feedback.',
      "Set the team's way of working: interaction flow first, complexity later; coded prototypes to unblock product decisions; developer hand-off through artifacts built with Claude.",
      'Built the Converge design system as a React package with design tokens and governance rules for AI coding agents.',
      'Designed Key Metrics Over Time for KFC franchisees, replacing a manual Excel reporting process with a self-service report.',
    ],
  },
  {
    role: 'UX Designer',
    org: 'CashPak · via Globant',
    when: 'Jul 2023 – Jan 2024',
    text: 'Designed Pako, a digital wallet for Central America. Ran usability tests in Nicaragua and El Salvador and used the findings to localize the interface.',
  },
  {
    role: 'Product Designer',
    org: 'Blackboard · via Globant',
    when: 'Feb 2022 – Jun 2023',
    text: 'Redesigned communication between students and instructors (course inbox, announcements and messaging) through user research and workshops, while paying down technical debt.',
  },
  {
    role: 'UX Lead, Colombia Aprende',
    org: 'Ministry of Education of Colombia',
    when: 'Mar 2019 – Dec 2021',
    points: [
      'Led a team of 18: designers, developers, instructional designers, educational content managers, communicators and platform administrators.',
      'Redesigned Colombia Aprende with teachers and students into an ecosystem of 81,000 resources and 70+ microsites for about 300,000 regular users, peaking at 2.8 million during the pandemic. Content downloads grew 81% in one year.',
      'Designed Aprender Digital, an offline-first model for rural schools without internet: curated content packages that teachers carry to class as a single file. Shipped the MVP in three months; the site still draws about 1,200 visits a month from a niche audience.',
    ],
  },
];

const skills = [
  { k: 'Product design', v: 'User research · Information architecture · Interaction design · Usability testing · UX writing · Accessibility · Workshop facilitation' },
  { k: 'Design engineering', v: 'Design systems · Design tokens · React component libraries · Coded prototypes · HTML, CSS and Astro' },
  { k: 'AI', v: 'Claude · Claude Code · OpenCode · Kimi · Gemini · ChatGPT · Figma Make · Governance for AI coding agents' },
  { k: 'Tools', v: 'Figma · Notion · Miro' },
  { k: 'Languages', v: 'Spanish (native) · English (B2)' },
];
---

<Layout
  title="Résumé — William Montoya"
  description="Résumé of William Montoya, Senior Product Designer: design systems, AI prototyping and design engineering at Deloitte, and former UX Lead of Colombia Aprende."
>
  <header class="cv-head wrap">
    <div class="cv-head__title">
      <p class="t-small t-muted">Résumé · Updated October 2026</p>
      <RiseTitle lead="William Montoya," accent="Senior Product Designer." accentBreak />
    </div>
    <div class="split">
      <ul class="cv-contact list-reset split__label t-small" role="list">
        <li>Medellín, Colombia · Remote</li>
        <li><a class="link" href="mailto:william@dejesumensaje.com">william@dejesumensaje.com</a></li>
        <li><a class="link" href="https://www.linkedin.com/in/dejesumensaje/" target="_blank" rel="noopener noreferrer">linkedin.com/in/dejesumensaje <span aria-hidden="true">↗</span></a></li>
      </ul>
      <div class="split__body cv-lede">
        <p class="t-lead measure">Design systems, AI prototyping and design engineering. A background in journalism and the social design of technology.</p>
        <div class="cv-actions">
          <a class="btn btn--primary" href={pdf} download>Download PDF <span aria-hidden="true">↓</span></a>
          <a class="btn btn--outline" href="https://www.linkedin.com/in/dejesumensaje/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </header>

  <section class="cv-section wrap" aria-labelledby="cv-profile" data-reveal>
    <div class="split">
      <h2 id="cv-profile" class="t-h3 split__label">Profile</h2>
      <p class="split__body measure">Product designer with a background in journalism and the social design of technology. At Deloitte I lead design for the two Converge platforms that currently generate revenue, for Pizza Hut and a major US grocery retailer, working daily with product, engineering and data in teams of 10 to 20 people. I start with the interaction flow before adding complexity. I build working prototypes to unblock decisions with PMs, and I hand off to developers through coded artifacts instead of static specs. Before Deloitte, I led an 18-person team that redesigned Colombia Aprende, the Ministry of Education's national learning portal.</p>
    </div>
  </section>

  <section class="cv-section wrap" aria-labelledby="cv-exp" data-reveal>
    <div class="split">
      <h2 id="cv-exp" class="t-h3 split__label">Experience</h2>
      <ol class="list-reset cv-items split__body" role="list">
        {experience.map((e) => (
          <li class="cv-item">
            <div class="cv-item__head">
              <div>
                <h3 class="t-h3">{e.role}</h3>
                <p class="t-muted">{e.org}</p>
              </div>
              <p class="t-small t-muted cv-when">{e.when}</p>
            </div>
            {e.text && <p class="measure">{e.text}</p>}
            {e.points && (
              <ul class="list-reset cv-points measure" role="list">
                {e.points.map((p) => <li>{p}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cv-section wrap" aria-labelledby="cv-teach" data-reveal>
    <div class="split">
      <h2 id="cv-teach" class="t-h3 split__label">Teaching</h2>
      <ol class="list-reset cv-items split__body" role="list">
        <li class="cv-item">
          <div class="cv-item__head">
            <div>
              <h3 class="t-h3">Adjunct Lecturer</h3>
              <p class="t-muted">Universidad de Antioquia · School of Communications</p>
            </div>
            <p class="t-small t-muted cv-when">2025 – present</p>
          </div>
          <p class="measure">Sensory Thinking; Interactive Narrative Lab. <a class="link" href="https://catedra.dejesumensaje.com" target="_blank" rel="noopener noreferrer">catedra.dejesumensaje.com <span aria-hidden="true">↗</span></a></p>
        </li>
        <li class="cv-item">
          <div class="cv-item__head">
            <div>
              <h3 class="t-h3">Extension Instructor</h3>
              <p class="t-muted">Universidad Nacional de Colombia</p>
            </div>
            <p class="t-small t-muted cv-when">2020 – present</p>
          </div>
          <p class="measure">Digital marketing and digital skills programs for public institutions.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="cv-section wrap" aria-labelledby="cv-skills" data-reveal>
    <div class="split">
      <h2 id="cv-skills" class="t-h3 split__label">Skills</h2>
      <dl class="cv-skills split__body">
        {skills.map((s) => (
          <div><dt class="t-small t-muted">{s.k}</dt><dd>{s.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="cv-section cv-section--last wrap" aria-labelledby="cv-edu" data-reveal>
    <div class="split">
      <h2 id="cv-edu" class="t-h3 split__label">Education</h2>
      <ol class="list-reset cv-items split__body" role="list">
        <li class="cv-item">
          <div class="cv-item__head">
            <div>
              <h3 class="t-h3">Graduate Specialization, Design and Social Management of Technology</h3>
              <p class="t-muted">Universidad de los Andes</p>
            </div>
            <p class="t-small t-muted cv-when">2016</p>
          </div>
        </li>
        <li class="cv-item">
          <div class="cv-item__head">
            <div>
              <h3 class="t-h3">BA, Journalism</h3>
              <p class="t-muted">Universidad de Antioquia</p>
            </div>
            <p class="t-small t-muted cv-when">2009</p>
          </div>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<style>
  .cv-head {
    padding-top: var(--space-page-top);
    padding-bottom: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .cv-head__title { display: flex; flex-direction: column; gap: 24px; }
  .cv-contact { display: flex; flex-direction: column; gap: 8px; padding-top: 6px; }
  .cv-contact a { overflow-wrap: anywhere; }
  .cv-lede { display: flex; flex-direction: column; gap: 32px; }
  .cv-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .cv-section { padding-bottom: var(--space-chapter); }
  .cv-section--last { padding-bottom: var(--space-before-footer); }

  .cv-items { display: flex; flex-direction: column; gap: 48px; }
  .cv-item { display: flex; flex-direction: column; gap: 16px; }
  .cv-item__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
  }
  .cv-item__head > div { display: flex; flex-direction: column; gap: 4px; max-width: 746px; }
  .cv-when { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cv-points { display: flex; flex-direction: column; gap: 12px; }
  .cv-points li { display: flex; gap: 16px; }
  .cv-points li::before { content: '—'; color: var(--muted); flex: none; }

  .cv-skills { display: flex; flex-direction: column; gap: 24px; margin: 0; }
  .cv-skills div {
    display: grid;
    grid-template-columns: 2fr 7fr;
    column-gap: var(--gutter);
    align-items: baseline;
  }
  .cv-skills dd { margin: 0; }

  @media (max-width: 759px) {
    .cv-head { gap: 40px; }
    .cv-head .split__body { order: -1; }
    .cv-skills div { grid-template-columns: 1fr; row-gap: 4px; }
    .cv-item__head { flex-direction: column; align-items: flex-start; gap: 4px; }
    .cv-when { order: -1; }
  }

  /* ---------- Print / PDF (Letter) ----------
     Same system, scaled for paper: two columns kept, display title smaller,
     nothing interactive. The PDF in /assets is generated from this. */
  @page { size: Letter; margin: 0.55in 0.6in; }
  @media print {
    :global(:root) {
      --text-display: 34px;
      --text-h3: 15px;
      --text-lead: 14px;
      --text-body: 12.5px;
      --text-small: 10.5px;
      --tracking-display: -0.8px;
      --tracking-h3: -0.1px;
      --gutter: 16px;
      --grid-margin: 0px;
    }
    :global(html), :global(body) { background: #fff !important; }
    :global(.nav), :global(.footer), :global(.skip-link), :global(.menu), .cv-actions { display: none !important; }
    :global(.js [data-reveal]), :global(.rise [data-w]) { opacity: 1 !important; transform: none !important; animation: none !important; }
    :global(.wrap) { max-width: none; padding-inline: 0; }
    /* Blocks instead of grid: Chrome splits blocks across pages cleanly,
       a grid row it would push whole to the next page. */
    :global(.split) { display: block !important; }
    :global(.split)::after { content: ''; display: block; clear: both; }
    :global(.split > .split__label) { float: left; width: 21%; }
    :global(.split > .split__body) { margin-left: 24%; }
    :global(.measure) { max-width: none; }
    body { font-size: var(--text-body); line-height: 1.45; }

    .cv-head { padding: 0 0 14px; gap: 12px; }
    .cv-head__title { gap: 6px; }
    .cv-head .split__body { order: 0; }
    .cv-head .cv-contact { float: left; width: 23%; }
    .cv-contact a { overflow-wrap: normal; white-space: nowrap; }
    /* Arrows are for screens: on paper a link is just its text. */
    :global(main [aria-hidden='true']) { display: none; }
    .cv-item__head > div { flex: 1 1 0; min-width: 0; }
    .cv-lede { gap: 0; }
    .cv-contact { gap: 2px; padding-top: 2px; }
    .cv-contact :global(.link), .cv-points, .cv-item p { text-decoration: none; }

    .cv-section, .cv-section--last { padding: 11px 0 0; margin-top: 11px; border-top: 0.75px solid #dddfe3; }
    .cv-items { gap: 11px; }
    .cv-item { gap: 4px; break-inside: avoid; }
    .cv-item__head { flex-direction: row; align-items: baseline; }
    .cv-item__head > div { gap: 1px; }
    .cv-when { order: 0; }
    .cv-points { gap: 3px; }
    .cv-points li { gap: 8px; }
    .cv-skills { gap: 5px; }
    .cv-skills div { grid-template-columns: 1.3fr 4fr; column-gap: 12px; }
    h2, h3 { break-after: avoid; }
  }
</style>
