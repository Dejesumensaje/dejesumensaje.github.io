---
import Layout from '../../layouts/Layout.astro';
import RiseTitle from '../../components/f/RiseTitle.astro';

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const now = [
  { k: 'Actualmente', v: 'Senior Product Designer en Globant, trabajando con Deloitte.' },
  { k: 'Enfoque', v: 'Productos y experiencias digitales que tengan algo que decir, que resolver o que cuestionar.' },
  { k: 'Fortalezas', v: 'Conectar ideas, encontrar soluciones inesperadas y pensar en quien está al otro lado de la pantalla.' },
];
const beliefs = [
  { t: 'Entender a las personas', b: 'Diseñar desde sus realidades, no desde nuestros supuestos.' },
  { t: 'Aprender de lo inesperado', b: 'Reconocer que las personas transforman y reinterpretan lo que diseñamos.' },
  { t: 'Comprender el sistema', b: 'Conectar las experiencias con las necesidades y realidades que las hacen posibles.' },
];
const jobs = [
  { org: 'Globant / Deloitte', role: 'Senior Product Designer', what: 'Sistemas de diseño, herramientas de precios y gobernanza de IA para Converge for Restaurants (KFC, Pizza Hut).', when: '2024–actualidad' },
  { org: 'Globant / CashPak', role: 'UX Designer', what: 'Diseñé Pako, una billetera digital para Centroamérica, e hice pruebas de usabilidad en Nicaragua y El Salvador.', when: '2023–2024' },
  { org: 'Globant / Blackboard', role: 'Product Designer', what: 'Rediseñé la comunicación entre estudiantes e instructores: bandeja de entrada de los cursos, anuncios y mensajes.', when: '2022–2023' },
  { org: 'Ministerio de Educación de Colombia', role: 'UX Lead', what: 'Lideré el rediseño de Colombia Aprende y Aprender Digital, plataformas nacionales que llegaron a 3,5 millones de usuarios en el punto más alto de la pandemia, con un equipo de 18 personas.', when: '2019–2021' },
];
const tools = [
  { t: 'IA para pensar y explorar', b: 'Uso Claude, ChatGPT y Kimi para investigar, explorar alternativas, desarrollar ideas y probar posibles caminos. Hacer buenas preguntas es solo una parte del trabajo. También necesito evaluar qué funciona, qué no y cuándo conviene cambiar de dirección.' },
  { t: 'Hacer tangibles las ideas', b: 'Cuando necesito llevar más lejos un artefacto de diseño, uso Claude Design como punto de partida y luego lo refino manualmente. Trabajo sobre el contraste, la jerarquía visual y los detalles de interacción para expresar mejor la idea y dirigir la atención hacia lo importante.' },
  { t: 'Llevar las decisiones a desarrollo', b: 'Figma es donde refino y documento el diseño y preparo su entrega a desarrollo. Con integraciones MCP puedo crear documentación detallada que ayuda a conservar las decisiones visuales durante la implementación y mantener la intención de la experiencia.' },
];
const skills = [
  { k: 'Núcleo UX', items: ['Investigación con usuarios', 'Arquitectura de información', 'Pruebas de usabilidad', 'Escritura UX', 'Wireframes', 'Prototipado', 'Estrategia de diseño'] },
  { k: 'Fortalezas', items: ['Pensamiento sistémico', 'Dirección de diseño', 'Accesibilidad', 'Sistemas de diseño', 'Facilitación de talleres', 'Flujos de trabajo con IA'] },
  { k: 'Herramientas de mi proceso actual', items: ['Claude', 'ChatGPT', 'Kimi', 'Claude Design', 'Figma', 'Integraciones MCP'] },
];
const games = [
  { title: 'Consume Me', date: '25 sep', img: 'coajxj' },
  { title: 'Tears of the Kingdom', date: '08 jul', img: 'co5vmg' },
  { title: '007 First Light', date: '30 jun', img: 'coaoiz' },
  { title: 'Mixtape', date: '18 may', img: 'coc2wi' },
  { title: 'Pragmata', date: '13 may', img: 'cobxnx' },
];
---

<Layout
  title="Sobre mí — William Montoya"
  description="Diseñador UX, periodista y docente. Construyo puentes claros entre las personas y la tecnología."
>
  <!-- Header -->
  <header class="about-head wrap">
    <div class="about-head__title">
      <RiseTitle lead="Construyo puentes claros entre" accent="las personas y la tecnología" accentBreak />
    </div>

    <div class="about-intro">
      <img
        class="about-intro__portrait"
        src="/assets/f/about-portrait.webp"
        width="720"
        height="540"
        alt="William Montoya, sonriente, con chaqueta de jean."
        fetchpriority="high"
      />
      <div class="about-intro__text">
        <p class="about-lede measure-wide">Soy diseñador UX, periodista y docente de diseño de interacción y pensamiento sensorial. Me interesa entender cómo las personas se relacionan con la tecnología y aprender de esas experiencias para crear productos y dinámicas de uso significativas.</p>
        <dl class="cols3">
          {now.map((n) => (
            <div><dt class="t-small t-muted">{n.k}</dt><dd>{n.v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </header>

  <!-- My story -->
  <section class="chapter wrap" aria-labelledby="a-story" data-reveal>
    <div class="split">
      <h2 id="a-story" class="t-h3 split__label">Mi historia</h2>
      <div class="split__body">
        <div class="prose measure">
          <p>Soy periodista egresado de la Universidad de Antioquia. Comencé mi carrera en el periodismo digital, trabajando en especiales multimedia. <strong>Me interesaba conectar la forma y el contenido para contar historias no solo a través de palabras y sonidos, sino también a través de lo que las personas percibían y hacían.</strong></p>
          <p>Mi paso por el Ministerio TIC amplió mi mirada sobre la tecnología y su dimensión humana. <strong>Una herramienta no resuelve nunca un problema por sí sola: su valor depende de cómo la gente la entiende y la incorpora a su contexto social y cultural.</strong></p>
          <p>Durante mi especialización en la Universidad de los Andes, el enfoque de capacidades y la perspectiva sociotécnica me permitieron profundizar en estas ideas.</p>
          <p>En el Ministerio de Educación tuve la fortuna de ver cómo las decisiones de diseño influían en lo que una comunidad educativa podía hacer, pero también entendí que <strong>ningún proceso de diseño determina por completo la forma cómo se usa o se entiende una tecnología</strong>.</p>
          <p><strong>Hay algo hermoso en el azar y en la subjetividad humanas.</strong></p>
          <p>Las personas se adaptan, encuentran atajos y resuelven problemas de formas imprevistas.</p>
          <p>Personalmente creo que soltar la necesidad de control nos permite entender mucho mejor a quienes usan lo que diseñamos y, ante todo, es una forma de recordar que <strong>diseñamos para personas reales, no para nosotros mismos</strong>.</p>
          <p>Hoy en día, abordo el diseño de adentro hacia afuera, conectando los objetivos del negocio, las realidades técnicas y las necesidades de los usuarios.</p>
          <p>Investigo para cuestionar supuestos, escribo para aclarar y dar forma a las decisiones e <strong>itero, itero muchísimo, para poder realmente aprender de quienes usan el producto.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I believe -->
  <section class="chapter wrap" aria-labelledby="a-believe" data-reveal>
    <div class="split">
      <h2 id="a-believe" class="t-h3 split__label">Lo que creo</h2>
      <div class="stack split__body">
        <p class="t-h2 measure-wide">El diseño debe crear entendimiento</p>
        <div class="cols3">
          {beliefs.map((b) => (
            <div><h3 class="t-h3">{b.t}</h3><p class="t-muted">{b.b}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="chapter wrap" aria-labelledby="a-exp" data-reveal>
    <div class="split">
      <h2 id="a-exp" class="t-h3 split__label">Experiencia</h2>
      <div class="split__body exp">
        <ol class="list-reset exp__list" role="list">
          {jobs.map((j) => (
            <li class="exp__row">
              <div class="exp__who">
                <h3 class="t-h3">{j.org}</h3>
                <p class="t-muted">{j.role}</p>
              </div>
              <p class="exp__what">{j.what}</p>
              <p class="t-small t-muted exp__when">{j.when}</p>
            </li>
          ))}
        </ol>
        <p class="exp__links">
          <a class="link" href="/es/resume">Hoja de vida completa <span aria-hidden="true">→</span></a>
          <a class="link" href="/assets/cv-william-montoya-2026-es.pdf" download>Descargar PDF <span aria-hidden="true">↓</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- How I work today -->
  <section class="chapter wrap" aria-labelledby="a-work" data-reveal>
    <div class="split">
      <h2 id="a-work" class="t-h3 split__label">Cómo trabajo hoy</h2>
      <div class="stack split__body" style="gap:var(--space-14)">
        <p class="about-lede measure-wide">Mi proceso combina investigación, experimentación, criterio y construcción. La IA forma parte activa de ese proceso: me ayuda a explorar posibilidades, mientras mantengo la responsabilidad sobre el brief, las decisiones y la calidad del resultado.</p>
        <div class="cols3">
          {tools.map((t) => (
            <div><h3 class="t-h3 tools__title">{t.t}</h3><p class="t-muted">{t.b}</p></div>
          ))}
        </div>
        <div class="cols3">
          {skills.map((s) => (
            <div>
              <h3 class="t-small t-muted">{s.k}</h3>
              <ul class="list-reset skills" role="list">{s.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond design -->
  <section class="chapter chapter--last wrap" aria-labelledby="a-beyond">
    <div class="split">
      <h2 id="a-beyond" class="t-h3 split__label" data-reveal>Más allá del diseño</h2>
      <div class="split__body beyond">
        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Docencia</h3>
            <p class="t-muted">Enseño pensamiento sensorial en la Universidad de Antioquia: cómo la percepción, la emoción y la atención influyen en la forma en que las personas experimentan los sistemas digitales. En mis clases exploro el diseño como lenguaje de expresión: cómo la forma puede comunicar, conmovernos y abrir nuevas interpretaciones.</p>
            <a class="link" href="https://catedra.dejesumensaje.com/" target="_blank" rel="noopener noreferrer">Cátedra, archivo de mis cursos <span aria-hidden="true">↗</span></a>
            <div class="beyond__feature">
              <p class="t-small t-muted">Guía destacada</p>
              <a class="link" href="https://catedra.dejesumensaje.com/diseno-visual/" target="_blank" rel="noopener noreferrer">Anatomía del diseño visual <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <a class="stage beyond__stage" href="https://catedra.dejesumensaje.com/" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <div class="browser" style={`left:${pct(48, 636)};top:${pct(34, 400)};width:${pct(540, 636)}`}>
              <div class="browser__bar"><i></i><i></i><i></i></div>
              <img src="/assets/f/catedra.webp" width="1200" height="675" alt="" loading="lazy" />
            </div>
          </a>
        </article>

        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Alucine</h3>
            <p class="t-muted">Un proyecto sobre cine y cultura en el que exploro historias, símbolos y las maneras en que la narrativa puede cambiar nuestra comprensión del mundo.</p>
            <a class="link" href="https://alucine.co/" target="_blank" rel="noopener noreferrer">alucine.co <span aria-hidden="true">↗</span></a>
          </div>
          <a class="stage beyond__stage" href="https://alucine.co/" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <div class="browser" style={`left:${pct(48, 636)};top:${pct(34, 400)};width:${pct(540, 636)}`}>
              <div class="browser__bar"><i></i><i></i><i></i></div>
              <img src="/assets/f/alucine.webp" width="1200" height="675" alt="" loading="lazy" />
            </div>
          </a>
        </article>

        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Videojuegos</h3>
            <p class="t-muted">Me interesan los mundos que construyen los videojuegos, sus reglas, sus posibilidades y las formas inesperadas en que las personas los habitan.</p>
            <a class="link" href="https://backloggd.com/u/dejesumensaje/" target="_blank" rel="noopener noreferrer">backloggd <span aria-hidden="true">↗</span></a>
          </div>
          <div class="stage beyond__stage games" data-games>
            <div class="games__head">
              <p class="t-small t-muted">Jugados hace poco</p>
              <div class="games__controls">
                <button class="icon-btn icon-btn--sm" type="button" data-prev disabled>
                  <span class="sr-only">Juegos anteriores</span>
                  <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M14 9H4m4-4L4 9l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="icon-btn icon-btn--sm" type="button" data-next>
                  <span class="sr-only">Más juegos</span>
                  <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <ul class="list-reset games__track" role="list" data-track>
              {games.map((g) => (
                <li class="game">
                  <img src={`/assets/f/game-${g.img}.webp`} width="300" height="400" alt={`Portada de ${g.title}`} loading="lazy" />
                  <p class="t-small game__title">{g.title}</p>
                  <p class="t-small t-muted">{g.date}</p>
                </li>
              ))}
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-head {
    padding-top: var(--space-page-top);
    padding-bottom: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
  }
  .about-head__title { display: flex; flex-direction: column; gap: var(--space-6); }
  .about-head__title :global(.rise) { max-width: 16em; }

  .about-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
  }
  .about-intro__portrait {
    grid-column: 1 / span 3;
    width: 100%;
    height: auto;
    aspect-ratio: 306 / 400;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .about-intro__text {
    grid-column: 4 / -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .cols3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    margin: 0;
  }
  .cols3 > div { display: flex; flex-direction: column; gap: var(--space-3); }
  .cols3 dd { margin: 0; }

  /* Intro and "How I work" lede: between body and t-h2 */
  .about-lede {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: -0.6px;
    line-height: 1.3;
    text-wrap: pretty;
  }
  .prose strong { font-weight: 600; }
  /* Tool titles reserve two lines so the three paragraphs start level */
  .tools__title { min-height: 2.4em; }

  .chapter { padding-bottom: var(--space-section); }
  .chapter--last { padding-bottom: var(--space-before-footer); }
  .stack { display: flex; flex-direction: column; gap: var(--space-12); }

  /* Experience: who (3 cols) · what (4 cols) · when (2 cols, right) */
  .exp { display: flex; flex-direction: column; gap: var(--space-10); }
  .exp__list { display: flex; flex-direction: column; gap: var(--space-10); }
  .exp__row {
    display: grid;
    grid-template-columns: 3fr 4fr 2fr;
    column-gap: var(--gutter);
    row-gap: var(--space-2);
  }
  .exp__who { display: flex; flex-direction: column; gap: var(--space-1); }
  .exp__what { padding-top: var(--space-1); max-width: 416px; }
  .exp__when { padding-top: var(--space-2); text-align: right; font-variant-numeric: tabular-nums; }
  .exp__links { display: flex; gap: var(--space-8); flex-wrap: wrap; padding-top: var(--space-2); }
  .skills { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-1); }

  /* Beyond design: text (3 cols) beside a stage (6 cols) */
  .beyond { display: flex; flex-direction: column; gap: var(--space-14); }
  .beyond__row {
    display: grid;
    grid-template-columns: 3fr 6fr;
    column-gap: var(--gutter);
    row-gap: var(--space-6);
    align-items: start;
  }
  .beyond__text { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .beyond__feature { display: flex; flex-direction: column; gap: var(--space-1); padding-top: var(--space-5); }
  .beyond__stage { aspect-ratio: 636 / 400; display: block; }
  .beyond__stage .browser { transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    a.beyond__stage:hover .browser { transform: translateY(-4px); }
  }

  /* Recently played: a small shelf inside the stage */
  .games { display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-7) 0 0; }
  .games__head { display: flex; justify-content: space-between; align-items: center; padding-inline: var(--space-8); }
  .games__controls { display: flex; gap: var(--space-2); }
  .icon-btn--sm { width: 36px; height: 36px; }
  .games__track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-8);
    padding: 0 var(--space-8) var(--space-7);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .games__track::-webkit-scrollbar { display: none; }
  .game { flex: 0 0 150px; scroll-snap-align: start; display: flex; flex-direction: column; gap: var(--space-1); }
  .game img {
    width: 150px;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-3);
    box-shadow: 0 10px 24px -12px rgba(23, 24, 26, 0.35);
  }
  .game__title { color: var(--ink); }

  @media (max-width: 1300px) {
    .exp__row { grid-template-columns: 1fr; }
    .exp__when { text-align: left; padding-top: 0; order: -1; }
  }
  @media (max-width: 899px) {
    .about-intro__portrait { grid-column: 1 / span 5; }
    .about-intro__text { grid-column: 6 / -1; }
    .beyond__row { grid-template-columns: 1fr; }
  }
  @media (max-width: 759px) {
    .about-head { gap: var(--space-10); }
    .about-intro__portrait { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .about-intro__text { grid-column: 1 / -1; }
    .cols3 { grid-template-columns: 1fr; }
    .about-lede { font-size: 22px; }
    .tools__title { min-height: 0; }
    .games__head { padding-inline: var(--space-5); }
    .games__track { padding-inline: var(--space-5); scroll-padding-inline: var(--space-5); }
    .games__controls { display: none; }
    .beyond__stage.games { aspect-ratio: auto; }
  }
</style>

<script>
  // Recently played: arrows move one cover; disabled at the ends.
  document.querySelectorAll<HTMLElement>('[data-games]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 16;
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: still.matches ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: still.matches ? 'auto' : 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
