---
import CaseLayout from '../../layouts/CaseLayout.astro';
import CaseHeader from '../../components/f/CaseHeader.astro';
import NextStory from '../../components/f/NextStory.astro';
import BeforeAfter from '../../components/f/BeforeAfter.astro';

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const facts = [
  { k: 'Rol', v: 'Ingeniería de sistemas de diseño, arquitectura de tokens, herramientas de IA y gobernanza' },
  { k: 'Fecha', v: '2025 – en curso' },
  { k: 'Cliente', v: 'Deloitte, productos para restaurantes y retail' },
  { k: 'Sistema de diseño en Figma', v: 'Grecia Gabriel y Rebecca Bradley' },
];
const overview = [
  { k: 'Reto', v: 'Teníamos un sistema de diseño sólido en Figma, pero quedaba fuera en cuanto los PM prototipaban con IA: vivía en un lugar al que esas herramientas no accedían.' },
  { k: 'Aporte', v: 'Implementación de la librería en React, arquitectura de tokens, paquete publicado en npm, playground de componentes y modelo de gobernanza para herramientas de IA.' },
  { k: 'Restricciones', v: 'Contexto empresarial con acuerdo de confidencialidad; los componentes deben renderizarse sin conflictos en cualquier entorno; las reglas deben ser lo bastante claras para que un agente las siga al pie de la letra.' },
  { k: 'Resultado', v: 'Un paquete en npm y un Make Kit en uso en la línea de pricing, y una skill portable para Claude con linter de diseño determinista. Un prototipo de pricing reconstruido con la skill pasó de 1.723 errores de lint a ninguno.' },
];
const skillFiles = [
  { f: 'SKILL.md', d: 'El flujo de trabajo (lectura de diseño, construcción, autocrítica) y las reglas que siempre están activas: una sola acción principal verde por vista, espaciado en base 4, Open Sans en 400 y 600, un control por intención.' },
  { f: 'references/foundations.md', d: 'Tokens de color, gráficos, tipografía y espaciado.' },
  { f: 'references/components.md', d: 'El catálogo de componentes, una matriz de controles y los requisitos de WCAG 2.2 AA.' },
  { f: 'references/anti-slop.md', d: 'Reglas visuales y de microcopy, cada una con un ejemplo malo y uno bueno.' },
  { f: 'references/claude-ai-formats.md', d: 'Cómo construir para React Artifacts, HTML independiente y canvas de Claude.' },
  { f: 'kit/', d: 'La hoja de estilos del sistema y una pantalla inicial para cada formato.' },
  { f: 'scripts/design-lint.js', d: 'La revisión determinista. Errores por espaciado fuera de la escala, colores fuera de la paleta, selects nativos, encabezados de tabla fuera del estilo del sistema y marcado roto; advertencias por emojis, palabras de moda, fuentes y degradados.' },
];
const resultNumbers = [
  { v: '1.723 → 0', k: 'errores de design-lint, primer prototipo frente a reconstrucción' },
  { v: '59 → 137', k: 'pantallas y estados cubiertos, primer prototipo frente a reconstrucción' },
  { v: '0', k: 'pasos añadidos o quitados del flujo' },
];
const ba = { labels: { before: 'Primer prototipo', after: 'Reconstruido con el sistema' }, range: 'Comparar el primer prototipo con la reconstrucción' };
const pairs = [
  {
    t: 'Restricciones y objetivos',
    b: 'Once pestañas de restricciones y una de objetivos, cada una con párrafos de explicación, pasan a ser una sola lista agrupada en objetivos, familias de producto y otras restricciones, con un estado en cada fila. Cada restricción se abre en un panel lateral, así la vista general no se pierde.',
    img: 'constraints',
    alt: ['Primer prototipo: doce pestañas de restricciones y objetivos sobre una tabla de familias y párrafos de explicación.', 'Reconstrucción: una lista de restricciones agrupada en objetivos, familias de producto y otras restricciones, con un estado en cada fila.'],
  },
  {
    t: 'Familias de producto',
    b: 'Cinco tarjetas de conteo y cuatro desplegables nativos pasan a ser pestañas por tipo con conteos, un buscador y el Select del sistema. Familias, restricciones y códigos de estrategia comparten un solo espacio de Settings.',
    img: 'families',
    alt: ['Primer prototipo: tarjetas de conteo, filtros con desplegables nativos y una tabla de familias densa.', 'Reconstrucción: Settings con pestañas, filtros por tipo con conteos, buscador, selector de categoría y la tabla de familias.'],
  },
  {
    t: 'Un nombre que ya existe',
    b: 'El error deja de ser una frase al pie del formulario y aparece en el campo; Next queda deshabilitado con su motivo al lado. Las zonas pasan a ser una lista de casillas con el número de tiendas y un “All zones” de tres estados, el control que la skill indica para selecciones múltiples cortas.',
    img: 'name',
    alt: ['Primer prototipo: botones de zona y una frase de error al pie del formulario.', 'Reconstrucción: el error bajo el campo de nombre, Next deshabilitado con su motivo y las zonas como lista de casillas con número de tiendas.'],
  },
  {
    t: 'Editar una brecha de precio',
    b: 'Párrafos, tarjetas de opción y una tabla de referencia se reducen a un campo con un control segmentado % | $ y un error “Required”. Los modales quedan para decisiones cortas, como piden las reglas de controles.',
    img: 'dialog',
    alt: ['Primer prototipo: un diálogo con párrafos, tarjetas de tipo de separación, un error y una tabla de referencia.', 'Reconstrucción: un diálogo compacto con un campo, un selector de porcentaje o dólares y un error Required.'],
  },
];
const states = [
  { img: 'check', a: 'Lista del paso 2 con estados de conflicto y advertencia, y el aviso Check finished.', c: 'La verificación de restricciones corre en segundo plano; las filas muestran conflictos y advertencias, y un aviso abre el detalle' },
  { img: 'preview', a: 'Panel de vista previa de restricciones filtrado a dos reglas en conflicto.', c: 'Una vista previa de solo lectura de todas las reglas, filtrada a los conflictos; cada fila dice qué está mal' },
  { img: 'blocked', a: 'Paso 3 con Run deshabilitado y un enlace al paso 2.', c: 'Run queda deshabilitado con su motivo y un enlace al conflicto' },
  { img: 'failed', a: 'Un escenario fallido con su conflicto y un enlace a la configuración.', c: 'Una ejecución fallida nombra la regla en conflicto y enlaza a ella' },
  { img: 'warnings', a: 'Resultados de un escenario con dos advertencias junto a All hard constraints met.', c: 'Las advertencias nunca bloquean una ejecución; siguen visibles en el resultado' },
  { img: 'upload', a: 'Diálogo de revisión de carga con reglas nuevas y filas omitidas.', c: 'Una carga se revisa antes de aplicarse: qué se añade, qué se omite y por qué' },
];
const numbers = [
  { v: '2', k: 'puntos de entrada para la IA, un solo modelo de gobernanza' },
  { v: '3', k: 'auditores independientes por componente' },
  { v: '2,37:1', k: 'el contraste de advertencia que detectamos; WCAG exige 4,5:1' },
];
const decisions = [
  { t: 'El color de marca es escaso', b: 'Reservamos el verde de marca para la acción principal y sus anillos de foco; los estados activos y seleccionados usan tokens aparte. Dejar esa regla en tokens permite que un agente la aplique sin dudar.' },
  { t: 'Contraste medido', b: 'El color de advertencia parecía legible a simple vista, pero midió 2,37:1 frente al 4,5:1 que exige WCAG. Cambiamos el texto a un token más oscuro que cumple el estándar y dejamos la validación en una auditoría automática.' },
  { t: 'El sistema no toca lo que no es suyo', b: 'Los componentes corren dentro de prototipos a medio hacer y aplicaciones heredadas llenas de CSS. Por eso el paquete nunca inyecta estilos globales al HTML crudo: cero selectores sueltos como h1, body o button. Cada componente incluye su propio reset encapsulado.' },
  { t: 'Los tokens son contratos', b: 'Los nombres de los tokens calcan los de Figma, con todo y sus particularidades. Así, quien diseña en Figma y quien programa —o el agente que lee el código— hablan el mismo idioma. Cambiar un token sin acuerdo rompe el trabajo de los demás.' },
];
---

<CaseLayout
  title="Sistema de diseño para personas e IA — William Montoya"
  description="Cómo convertí un sistema de diseño que las demos con IA ignoraban en un paquete de código y un modelo de gobernanza para personas y agentes."
  readFull="7 min"
  readTldr="1 min"
>
  <CaseHeader
    lead="Llevar un sistema de diseño a la práctica para"
    accent="personas y agentes de IA"
    question="¿Cómo lograr que las herramientas y los agentes de IA usen el sistema de diseño real en lugar de imitarlo?"
    facts={facts}
    overview={overview}
    readFull="7 min"
    readTldr="1 min"
  />

  <figure class="figure figure--lead wrap" data-reveal>
    <div class="stage" style="aspect-ratio:1296/640">
      <div class="browser" style={`left:${pct(148, 1296)};top:${pct(56, 640)};width:${pct(1000, 1296)}`}>
        <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <img src="/assets/f/ds-colors.webp" width="1440" height="810" alt="El playground del sistema de diseño: los fundamentos de color, con tokens de marca, neutros, texto y selección." fetchpriority="high" />
      </div>
    </div>
  </figure>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-numbers" data-reveal>
    <div class="split">
      <h2 id="ch-numbers" class="t-h3 split__label">En cifras</h2>
      <div class="columns3 numbers split__body">
        {numbers.map((n) => (
          <div><p class="t-display">{n.v}</p><p class="t-muted">{n.k}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter wrap" aria-labelledby="ch-problem" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-problem" class="t-h3 split__label">El problema</h2>
      <div class="prose measure split__body">
        <p>El equipo de diseño ya tenía un sistema maduro en Figma, creado por Grecia Gabriel y Rebecca Bradley.</p>
        <p>El quiebre ocurrió cuando los product managers empezaron a usar Claude Code y Figma Make para explorar ideas con clientes. El sistema quedó fuera porque esas herramientas no podían leerlo desde Figma.</p>
        <p>La exploración ganó velocidad, pero la consistencia cayó igual de rápido. Los demos dejaron de compartir lenguaje visual, patrones de interacción y principios de UX. Cada PM improvisaba su propia interfaz y el sistema quedó reducido a un archivo de referencia que la IA no tocaba.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-why" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-why" class="t-h3 split__label">Por qué un buen sistema en Figma no bastaba</h2>
      <div class="chapter__stack split__body">
        <div class="prose measure">
          <p>Figma Make integra sistemas de diseño reales en prototipos con IA mediante Make Kits: un paquete de componentes, los tokens y estilos de Figma, y las pautas de uso para que la herramienta use el sistema real en lugar de inventar uno parecido.</p>
          <p>El cuello de botella es técnico: no puedes armar un Make Kit directo desde Figma. Primero necesitas un paquete de React publicado; solo entonces lo conectas al Make Kit y sumas las guías.</p>
        </div>
        <p class="t-h2 pull">El sistema funcionaba bien en diseño, pero ninguna herramienta de IA podía consumirlo. Teníamos que pasarlo a código.</p>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage" style="aspect-ratio:1296/680">
      <img class="flat" src="/assets/f/ds-button.webp" width="1600" height="1412" loading="lazy" alt="El componente Button en el playground: variantes, tamaños, íconos, estados y la barra de acciones masivas." style={`left:${pct(298, 1296)};top:${pct(48, 680)};width:${pct(700, 1296)}`} />
    </div>
  </figure>

  <section class="chapter wrap" aria-labelledby="ch-contribution" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-contribution" class="t-h3 split__label">Mi aporte</h2>
      <div class="chapter__stack split__body">
        <div class="prose measure">
          <p>Tomé el sistema que Grecia y Rebecca diseñaron en Figma y lo traduje a un paquete de código funcional para que los Make Kits y los agentes pudieran consumirlo directo. Implementé los componentes en React, estructuré los tokens, publiqué en npm y armé un playground para validar cada pieza antes de abrirla a otros equipos.</p>
        </div>
        <p class="t-h2 pull">Escribir el código fue el medio; gobernarlo, el verdadero reto.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-decisions" data-reveal>
    <div class="split">
      <h2 id="ch-decisions" class="t-h3 split__label">Las decisiones que lo sostienen</h2>
      <div class="chapter__stack split__body">
        <p class="measure" data-depth="full">Un paquete para agentes solo funciona si sus reglas eliminan la ambigüedad. Un diseñador con experiencia sabe navegar zonas grises; un agente sigue las reglas al pie de la letra y rellena cualquier vacío adivinando. Por eso tuvimos que afinar cada norma antes de publicarla.</p>
        <div class="grid2">
          {decisions.map((d) => (
            <div><h3 class="t-h3">{d.t}</h3><p class="t-muted">{d.b}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage" style="aspect-ratio:1296/600">
      <img class="flat" src="/assets/f/ds-metriccard.webp" width="1600" height="1171" loading="lazy" alt="Los componentes MetricCard e InformativeCard con insignias de estado." style={`left:${pct(318, 1296)};top:${pct(44, 600)};width:${pct(660, 1296)}`} />
    </div>
    <figcaption class="t-small">Cada estado tiene su propio token: un agente aplica «On track» o «Watch» sin adivinar</figcaption>
  </figure>

  <section class="chapter wrap" aria-labelledby="ch-org" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-org" class="t-h3 split__label">Gobernar la exploración</h2>
      <div class="prose measure split__body">
        <p>Los PM necesitaban prototipar con IA frente a los clientes sin producir interfaces inconexas y difíciles de mantener.</p>
        <p>Le dimos estructura a la exploración: un entorno controlado, componentes reales de producción en un playground, principios claros y un ciclo donde los conceptos explorados vuelven a diseño antes de pasar a producción.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-entry" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-entry" class="t-h3 split__label">Un sistema, dos puntos de entrada</h2>
      <div class="chapter__stack split__body">
        <div class="grid2">
          <div>
            <h3 class="t-h3">Figma Make</h3>
            <p class="t-muted">El Make Kit conecta nuestro paquete de npm, los tokens de Figma y las pautas de uso dentro de Figma Make. Así los PM prototipan con las mismas piezas que ingeniería lleva a producción.</p>
          </div>
          <div>
            <h3 class="t-h3">Claude Code</h3>
            <p class="t-muted">Mediante un archivo CLAUDE.md con la arquitectura y reglas estrictas, más skills reutilizables para construir, validar y documentar componentes. Tres auditores de solo lectura revisan cada pieza en paralelo: tokens, accesibilidad con contraste medido y QA.</p>
          </div>
        </div>
        <p class="t-h2 pull">Generar código es rápido, pero la IA se equivoca con total convicción. Por eso la disciplina recae en una capa de revisión que no aprueba su propio trabajo.</p>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage" style="aspect-ratio:1296/560">
      <img class="flat" src="/assets/f/ds-sidebar.webp" width="1600" height="796" loading="lazy" alt="El componente Sidebar en modo claro expandido y en modo oscuro colapsado." style={`left:${pct(248, 1296)};top:${pct(52, 560)};width:${pct(800, 1296)}`} />
    </div>
  </figure>

  <section class="chapter wrap" aria-labelledby="ch-claude" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-claude" class="t-h3 split__label">Directo a Claude</h2>
      <div class="prose measure split__body">
        <p>El siguiente paso saca la gobernanza de Figma Make y la lleva directo a Claude. En lugar de depender del puente del Make Kit, los equipos cargan una skill portable de prototipado que funciona en React Artifacts de claude.ai, HTML autónomo y lienzos de Claude Design.</p>
        <p>La skill reúne referencias progresivas de tokens y componentes junto con reglas anti-slop visuales y de microcopy: un solo CTA verde por vista, datos reales del dominio, cero emojis decorativos o filas de KPIs sin pedir, y textos directos sin repeticiones. Un linter en Node sin dependencias (design-lint.js) valida cada prototipo contra la escala de espaciado base 4, la paleta publicada, selectores nativos, tipografías fuera del sistema y textos de relleno.</p>
        <p>La colaboración también queda explícita. Producto e ingeniería exploran el comportamiento en su propia copia; si alguien insiste en romper una regla, Claude construye lo pedido y marca la entrega con «Design review:» nombrando la regla, para que diseño detecte cada excepción antes de integrar el cambio al prototipo principal.</p>
      </div>
    </div>
  </section>

  <section class="chapter wrap" aria-labelledby="ch-skill" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-skill" class="t-h3 split__label">Por dentro de la skill</h2>
      <div class="chapter__stack split__body">
        <p class="measure">La skill carga solo la referencia que necesita cada tarea.</p>
        <dl class="files">
          {skillFiles.map((s) => (
            <div><dt>{s.f}</dt><dd class="t-muted">{s.d}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-result" data-reveal>
    <div class="split">
      <h2 id="ch-result" class="t-h3 split__label">Resultado: un prototipo, antes y después</h2>
      <div class="chapter__stack split__body">
        <div class="prose measure">
          <p>El prototipo es una herramienta de optimización de precios para una cadena de supermercados: los equipos arman escenarios de optimización, definen las restricciones que deben respetar los precios, los ejecutan y publican el resultado.</p>
          <p>Un PM construyó el primer prototipo sin la skill y luego lo reconstruyó con ella. Yo pulí esa segunda versión: recorté el texto y la llevé por rondas con stakeholders del cliente. La versión pulida es la que documenta el hand-off en Figma.</p>
          <p>El linter encontró en el primer prototipo 1.281 colores fuera de la paleta, 408 valores de espaciado fuera de la escala de base 4 y 34 selects nativos; la reconstrucción no tiene ninguno. Las dos versiones de abajo muestran la misma pantalla desde el mismo preset, con datos de prueba.</p>
        </div>
        <div class="columns3 numbers">
          {resultNumbers.map((n) => (
            <div><p class="t-h2">{n.v}</p><p class="t-muted">{n.k}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="ba-list wrap">
    {pairs.map((p) => (
      <figure class="ba-item" data-reveal>
        <div class="split">
          <h3 class="t-h3 split__label">{p.t}</h3>
          <p class="t-muted split__body ba-item__note">{p.b}</p>
        </div>
        <BeforeAfter
          before={{ src: `/assets/f/ds-pricing-${p.img}-v1.webp`, alt: p.alt[0] }}
          after={{ src: `/assets/f/ds-pricing-${p.img}-v3.webp`, alt: p.alt[1] }}
          width={1600}
          height={1138}
          labels={ba.labels}
          rangeLabel={`${ba.range}: ${p.t}`}
        />
      </figure>
    ))}
  </div>

  <section class="chapter wrap" aria-labelledby="ch-states" data-reveal>
    <div class="chapter__stack">
      <div class="split">
        <h2 id="ch-states" class="t-h3 split__label">Estados que el primer prototipo no tenía</h2>
        <p class="t-muted split__body ba-item__note">Las restricciones pueden contradecirse, así que ejecutar un escenario necesitaba estados para verificar, bloquear, fallar y advertir. La verificación, la vista previa y la revisión de cargas salieron de una ronda con stakeholders.</p>
      </div>
      <ul class="shots">
        {states.map((s) => (
          <li>
            <img src={`/assets/f/ds-pricing-${s.img}.webp`} width="1600" height="1138" loading="lazy" decoding="async" alt={s.a} />
            <p class="t-small t-muted">{s.c}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-outcome" data-reveal>
    <div class="split">
      <h2 id="ch-outcome" class="t-h3 split__label">Primeros resultados</h2>
      <div class="prose measure split__body">
        <p>La línea de pricing ya trabaja con el paquete de npm, el Make Kit, reglas compartidas para Claude Code y sesiones de transferencia con los equipos. Ahora esas mismas reglas viven en la skill portable de prototipado para Claude y su linter de diseño, que valida cada prototipo antes de pasar a revisión.</p>
        <p>Con esas reglas en marcha, los PM iteran sobre exploraciones cercanas a producción, y mi tiempo va adonde debe: carga cognitiva, eficiencia y arquitectura de información.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-reflection" data-reveal>
    <div class="split">
      <h2 id="ch-reflection" class="t-h3 split__label">Reflexión</h2>
      <div class="split__body" style="display:flex;flex-direction:column;gap:var(--space-10)">
        <p class="t-h2 pull">Si cualquiera puede generar una pantalla en segundos, el trabajo pasa de dibujarlas a codificar las reglas que las mantienen coherentes.</p>
      </div>
    </div>
  </section>

  <NextStory current="/design-system-ai-agents" />
</CaseLayout>
