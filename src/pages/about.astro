---
import Layout from '../layouts/Layout.astro';
import RiseTitle from '../components/f/RiseTitle.astro';

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const now = [
  { k: 'Currently', v: 'Senior Product Designer at Globant, working on projects for Deloitte.' },
  { k: 'Focus', v: 'Digital products and experiences with something to say, solve, or question.' },
  { k: 'Strengths', v: 'Connecting ideas, finding unexpected solutions, and keeping the person on the other side of the screen in mind.' },
];
const beliefs = [
  { t: 'Understand people', b: 'Design around their realities, not our assumptions.' },
  { t: 'Learn from the unexpected', b: 'Recognize that people reshape and reinterpret what we design.' },
  { t: 'Understand the system', b: 'Connect experiences with the needs and realities that shape them.' },
];
const jobs = [
  { org: 'Globant / Deloitte', role: 'Senior Product Designer', what: 'Design systems, pricing tools and AI governance for Converge for Restaurants (KFC, Pizza Hut).', when: '2024–present' },
  { org: 'Globant / CashPak', role: 'UX Designer', what: 'Designed Pako, a digital wallet for Central America, and ran usability tests in Nicaragua and El Salvador.', when: '2023–2024' },
  { org: 'Globant / Blackboard', role: 'Product Designer', what: 'Redesigned student–instructor communication, including the course inbox, announcements and messaging.', when: '2022–2023' },
  { org: 'Ministry of Education, Colombia', role: 'UX Lead', what: 'Led the redesign of Colombia Aprende and Aprender Digital, national platforms that reached 3.5 million users at the pandemic peak, with a team of 18.', when: '2019–2021' },
];
const tools = [
  { t: 'AI as a thinking and exploration partner', b: 'I use Claude, ChatGPT, and Kimi to research, explore alternatives, develop ideas, and test possible directions. Asking the right questions is only part of the work. I also need to assess what holds up, what doesn’t, and when a different approach is needed.' },
  { t: 'Making ideas tangible', b: 'When a design artifact needs further development, I use Claude Design as a starting point and refine it manually. I work on contrast, visual hierarchy, and interaction details to make the idea clearer and guide attention where it matters.' },
  { t: 'Carrying decisions into development', b: 'Figma is where I refine the design, document decisions, and prepare the handoff. With MCP integrations, I can create detailed documentation that helps preserve visual decisions during implementation and keeps the intended experience intact.' },
];
const skills = [
  { k: 'UX core', items: ['User research', 'Information architecture', 'Usability testing', 'UX writing', 'Wireframing', 'Prototyping', 'Design strategy'] },
  { k: 'Strengths', items: ['Systems thinking', 'Design direction', 'Accessibility', 'Design systems', 'Workshop facilitation', 'AI-assisted workflows'] },
  { k: 'Tools in my current process', items: ['Claude', 'ChatGPT', 'Kimi', 'Claude Design', 'Figma', 'MCP integrations'] },
];
const games = [
  { title: 'Consume Me', date: 'Sep 25', img: 'coajxj' },
  { title: 'Tears of the Kingdom', date: 'Jul 08', img: 'co5vmg' },
  { title: '007 First Light', date: 'Jun 30', img: 'coaoiz' },
  { title: 'Mixtape', date: 'May 18', img: 'coc2wi' },
  { title: 'Pragmata', date: 'May 13', img: 'cobxnx' },
];
---

<Layout
  title="About — William Montoya"
  description="UX designer, journalist and educator. Designing clear bridges between people, business and technology."
>
  <!-- Header -->
  <header class="about-head wrap">
    <div class="about-head__title">
      <RiseTitle lead="Designing clear bridges between" accent="people, business and technology" accentBreak />
    </div>

    <div class="about-intro">
      <img
        class="about-intro__portrait"
        src="/assets/f/about-portrait.webp"
        width="720"
        height="540"
        alt="William Montoya, smiling, in a denim jacket."
        fetchpriority="high"
      />
      <div class="about-intro__text">
        <p class="about-lede measure-wide">I’m a UX designer, journalist, and educator in interaction design and sensory thinking. I’m interested in understanding how people relate to technology and learning from those experiences to create meaningful products and interactions.</p>
        <dl class="cols3">
          {now.map((n) => (
            <div><dt class="t-small t-muted">{n.k}</dt><dd>{n.v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </header>

  <!-- My story -->
  <section class="chapter wrap" aria-labelledby="a-story" data-reveal>
    <div class="split">
      <h2 id="a-story" class="t-h3 split__label">My story</h2>
      <div class="split__body">
        <div class="prose measure">
          <p>I’m a journalist with a degree from Universidad de Antioquia. I began my career in digital journalism, working on multimedia features. <strong>I was interested in bringing form and content together to tell stories not only through words and sounds, but also through what people perceived and did.</strong></p>
          <p>My time at Colombia’s Ministry of Information Technologies and Communications (MinTIC) broadened my perspective on technology and its human dimension. <strong>A tool doesn’t solve a problem on its own. Its value depends on how people understand it and incorporate it into their social and cultural contexts.</strong></p>
          <p>During my postgraduate studies at Universidad de los Andes, the capability approach and sociotechnical perspective helped me explore these ideas further.</p>
          <p>At Colombia’s Ministry of Education, I had the opportunity to see how design decisions shaped what an educational community could do. I also came to understand that <strong>no design process can fully determine how a technology will be used or understood.</strong></p>
          <p>There’s something beautiful about chance and human subjectivity.</p>
          <p>People adapt, find shortcuts, and solve problems in unexpected ways.</p>
          <p>I believe that letting go of the need for control helps us better understand the people who use what we design. Above all, it reminds us that <strong>we design for people, not for ourselves.</strong></p>
          <p>Today, I approach design from the inside out, bringing together business goals, technical realities, and people’s needs.</p>
          <p>I research to question assumptions, write to clarify and give shape to decisions, and <strong>iterate, iterate a lot, to truly learn from the people who use a product.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I believe -->
  <section class="chapter wrap" aria-labelledby="a-believe" data-reveal>
    <div class="split">
      <h2 id="a-believe" class="t-h3 split__label">What I believe</h2>
      <div class="stack split__body">
        <p class="t-h2 measure-wide">Design should create understanding</p>
        <div class="cols3">
          {beliefs.map((b) => (
            <div><h3 class="t-h3">{b.t}</h3><p class="t-muted">{b.b}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="chapter wrap" aria-labelledby="a-exp" data-reveal>
    <div class="split">
      <h2 id="a-exp" class="t-h3 split__label">Experience</h2>
      <div class="split__body exp">
        <ol class="list-reset exp__list" role="list">
          {jobs.map((j) => (
            <li class="exp__row">
              <div class="exp__who">
                <h3 class="t-h3">{j.org}</h3>
                <p class="t-muted">{j.role}</p>
              </div>
              <p class="exp__what">{j.what}</p>
              <p class="t-small t-muted exp__when">{j.when}</p>
            </li>
          ))}
        </ol>
        <p class="exp__links">
          <a class="link" href="/resume">Full résumé <span aria-hidden="true">→</span></a>
          <a class="link" href="/assets/cv-william-montoya-2026-en.pdf" download>Download PDF <span aria-hidden="true">↓</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- How I work today -->
  <section class="chapter wrap" aria-labelledby="a-work" data-reveal>
    <div class="split">
      <h2 id="a-work" class="t-h3 split__label">How I work today</h2>
      <div class="stack split__body" style="gap:var(--space-14)">
        <p class="about-lede measure-wide">My process brings together research, experimentation, judgment, and making. AI is part of that process: it helps me explore possibilities, while I remain responsible for the brief, the decisions, and the quality of the outcome.</p>
        <div class="cols3">
          {tools.map((t) => (
            <div><h3 class="t-h3 tools__title">{t.t}</h3><p class="t-muted">{t.b}</p></div>
          ))}
        </div>
        <div class="cols3">
          {skills.map((s) => (
            <div>
              <h3 class="t-small t-muted">{s.k}</h3>
              <ul class="list-reset skills" role="list">{s.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond design -->
  <section class="chapter chapter--last wrap" aria-labelledby="a-beyond">
    <div class="split">
      <h2 id="a-beyond" class="t-h3 split__label" data-reveal>Beyond design</h2>
      <div class="split__body beyond">
        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Teaching</h3>
            <p class="t-muted">I teach sensory thinking at Universidad de Antioquia: how perception, emotion and attention shape the way people experience digital systems. In my teaching, I explore design as a language for expression—how form can communicate, move us and open up new interpretations.</p>
            <a class="link" href="https://catedra.dejesumensaje.com/" target="_blank" rel="noopener noreferrer">Cátedra, my course archive <span aria-hidden="true">↗</span></a>
            <div class="beyond__feature">
              <p class="t-small t-muted">Featured guide</p>
              <a class="link" href="https://catedra.dejesumensaje.com/diseno-visual/" target="_blank" rel="noopener noreferrer">Anatomy of Visual Design <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <a class="stage beyond__stage" href="https://catedra.dejesumensaje.com/" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <div class="browser" style={`left:${pct(48, 636)};top:${pct(34, 400)};width:${pct(540, 636)}`}>
              <div class="browser__bar"><i></i><i></i><i></i></div>
              <img src="/assets/f/catedra.webp" width="1200" height="675" alt="" loading="lazy" />
            </div>
          </a>
        </article>

        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Alucine</h3>
            <p class="t-muted">A project about film and culture, where I explore stories, symbols and the ways narrative can shift how we understand the world.</p>
            <a class="link" href="https://alucine.co/" target="_blank" rel="noopener noreferrer">alucine.co <span aria-hidden="true">↗</span></a>
          </div>
          <a class="stage beyond__stage" href="https://alucine.co/" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <div class="browser" style={`left:${pct(48, 636)};top:${pct(34, 400)};width:${pct(540, 636)}`}>
              <div class="browser__bar"><i></i><i></i><i></i></div>
              <img src="/assets/f/alucine.webp" width="1200" height="675" alt="" loading="lazy" />
            </div>
          </a>
        </article>

        <article class="beyond__row" data-reveal>
          <div class="beyond__text">
            <h3 class="t-h3">Games</h3>
            <p class="t-muted">I’m drawn to the worlds video games create, their rules, their possibilities, and the unexpected ways people inhabit them.</p>
            <a class="link" href="https://backloggd.com/u/dejesumensaje/" target="_blank" rel="noopener noreferrer">backloggd <span aria-hidden="true">↗</span></a>
          </div>
          <div class="stage beyond__stage games" data-games>
            <div class="games__head">
              <p class="t-small t-muted">Recently played</p>
              <div class="games__controls">
                <button class="icon-btn icon-btn--sm" type="button" data-prev disabled>
                  <span class="sr-only">Previous games</span>
                  <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M14 9H4m4-4L4 9l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="icon-btn icon-btn--sm" type="button" data-next>
                  <span class="sr-only">More games</span>
                  <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <ul class="list-reset games__track" role="list" data-track>
              {games.map((g) => (
                <li class="game">
                  <img src={`/assets/f/game-${g.img}.webp`} width="300" height="400" alt={`${g.title} cover`} loading="lazy" />
                  <p class="t-small game__title">{g.title}</p>
                  <p class="t-small t-muted">{g.date}</p>
                </li>
              ))}
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-head {
    padding-top: var(--space-page-top);
    padding-bottom: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
  }
  .about-head__title { display: flex; flex-direction: column; gap: var(--space-6); }
  .about-head__title :global(.rise) { max-width: 16em; }

  .about-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
  }
  .about-intro__portrait {
    grid-column: 1 / span 3;
    width: 100%;
    height: auto;
    aspect-ratio: 306 / 400;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .about-intro__text {
    grid-column: 4 / -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .cols3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    margin: 0;
  }
  .cols3 > div { display: flex; flex-direction: column; gap: var(--space-3); }
  .cols3 dd { margin: 0; }

  /* Intro and "How I work" lede: between body and t-h2 */
  .about-lede {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: -0.6px;
    line-height: 1.3;
    text-wrap: pretty;
  }
    /* Tool titles reserve two lines so the three paragraphs start level */
  .tools__title { min-height: 2.4em; }

  .chapter { padding-bottom: var(--space-section); }
  .chapter--last { padding-bottom: var(--space-before-footer); }
  .stack { display: flex; flex-direction: column; gap: var(--space-12); }

  /* Experience: who (3 cols) · what (4 cols) · when (2 cols, right) */
  .exp { display: flex; flex-direction: column; gap: var(--space-10); }
  .exp__list { display: flex; flex-direction: column; gap: var(--space-10); }
  .exp__row {
    display: grid;
    grid-template-columns: 3fr 4fr 2fr;
    column-gap: var(--gutter);
    row-gap: var(--space-2);
  }
  .exp__who { display: flex; flex-direction: column; gap: var(--space-1); }
  .exp__what { padding-top: var(--space-1); max-width: 416px; }
  .exp__when { padding-top: var(--space-2); text-align: right; font-variant-numeric: tabular-nums; }
  .exp__links { display: flex; gap: var(--space-8); flex-wrap: wrap; padding-top: var(--space-2); }
  .skills { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-1); }

  /* Beyond design: text (3 cols) beside a stage (6 cols) */
  .beyond { display: flex; flex-direction: column; gap: var(--space-14); }
  .beyond__row {
    display: grid;
    grid-template-columns: 3fr 6fr;
    column-gap: var(--gutter);
    row-gap: var(--space-6);
    align-items: start;
  }
  .beyond__text { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .beyond__feature { display: flex; flex-direction: column; gap: var(--space-1); padding-top: var(--space-5); }
  .beyond__stage { aspect-ratio: 636 / 400; display: block; }
  .beyond__stage .browser { transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    a.beyond__stage:hover .browser { transform: translateY(-4px); }
  }

  /* Recently played: a small shelf inside the stage */
  .games { display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-7) 0 0; }
  .games__head { display: flex; justify-content: space-between; align-items: center; padding-inline: var(--space-8); }
  .games__controls { display: flex; gap: var(--space-2); }
  .icon-btn--sm { width: 36px; height: 36px; }
  .games__track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-8);
    padding: 0 var(--space-8) var(--space-7);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .games__track::-webkit-scrollbar { display: none; }
  .game { flex: 0 0 150px; scroll-snap-align: start; display: flex; flex-direction: column; gap: var(--space-1); }
  .game img {
    width: 150px;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-3);
    box-shadow: 0 10px 24px -12px rgba(23, 24, 26, 0.35);
  }
  .game__title { color: var(--ink); }

  @media (max-width: 1300px) {
    .exp__row { grid-template-columns: 1fr; }
    .exp__when { text-align: left; padding-top: 0; order: -1; }
  }
  @media (max-width: 899px) {
    .about-intro__portrait { grid-column: 1 / span 5; }
    .about-intro__text { grid-column: 6 / -1; }
    .beyond__row { grid-template-columns: 1fr; }
  }
  @media (max-width: 759px) {
    .about-head { gap: var(--space-10); }
    .about-intro__portrait { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .about-intro__text { grid-column: 1 / -1; }
    .cols3 { grid-template-columns: 1fr; }
    .about-lede { font-size: 22px; }
    .tools__title { min-height: 0; }
    .games__head { padding-inline: var(--space-5); }
    .games__track { padding-inline: var(--space-5); scroll-padding-inline: var(--space-5); }
    .games__controls { display: none; }
    .beyond__stage.games { aspect-ratio: auto; }
  }
</style>

<script>
  // Recently played: arrows move one cover; disabled at the ends.
  document.querySelectorAll<HTMLElement>('[data-games]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 16;
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: still.matches ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: still.matches ? 'auto' : 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
