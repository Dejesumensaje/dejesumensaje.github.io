---
import BaseLayout from '../layouts/BaseLayout.astro';

// Keep in sync with the PDF in public/assets (generated from this same content).
const pdf = '/assets/cv-william-montoya-2026-en.pdf';
---

<BaseLayout
  title="Resume — William Montoya"
  description="Resume of William Montoya, Senior Product Designer: design systems, AI prototyping and design engineering at Deloitte, and former UX Lead of Colombia Aprende."
  footerBridge={false}
>
  <main id="main-content" class="resume">
    <div class="resume-actions">
      <p class="resume-kicker">Resume · Updated October 2026</p>
      <div class="resume-buttons">
        <a href={pdf} class="button-cta" download>Download PDF</a>
        <a href="https://www.linkedin.com/in/dejesumensaje/" target="_blank" rel="noopener noreferrer" class="button-secondary">LinkedIn ↗</a>
      </div>
    </div>

    <article class="sheet">

      <header class="top">
        <h1>William Montoya</h1>
        <p class="tagline">Senior Product Designer · Design systems, AI prototyping, design engineering</p>
        <div class="contact">
          <span>Medellín, Colombia · Remote</span>
          <span>william@dejesumensaje.com</span>
          <span><a href="https://dejesumensaje.com" target="_blank" rel="noopener">dejesumensaje.com</a></span>
          <span><a href="https://www.linkedin.com/in/dejesumensaje" target="_blank" rel="noopener">linkedin.com/in/dejesumensaje</a></span>
        </div>
      </header>

      <section aria-labelledby="profile">
        <h2 id="profile">Profile</h2>
        <div class="content">
          <p>Product designer with a background in journalism and the social design of technology. At Deloitte I lead design for the two Converge platforms that currently generate revenue, for Pizza Hut and a major US grocery retailer, working daily with product, engineering and data in teams of 10 to 20 people. I start with the interaction flow before adding complexity. I build working prototypes to unblock decisions with PMs, and I hand off to developers through coded artifacts instead of static specs. Before Deloitte, I led an 18-person team that redesigned Colombia Aprende, the Ministry of Education's national learning portal.</p>
          <dl class="figures">
            <div><dt>Revenue platforms</dt><dd>2<small>Pizza Hut and a US grocery retailer, at Deloitte</small></dd></div>
            <div><dt>Team led</dt><dd>18<small>Multidisciplinary, at the Ministry of Education</small></dd></div>
            <div><dt>Peak users</dt><dd>2.8M<small>Colombia Aprende, during the pandemic</small></dd></div>
            <div><dt>Downloads</dt><dd>+81%<small>Content, one year after the redesign</small></dd></div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        <div class="content">

          <article class="item">
            <div class="item-head"><h3>Senior Product Designer</h3><span class="when">Feb 2024 – present</span></div>
            <p class="desc">Deloitte · Converge, via Globant</p>
            <ul class="points">
              <li>Own design for the Pizza Hut and US grocery retail platforms, the two Converge products billing at Deloitte, shipping fast iterations on client and end-user feedback.</li>
              <li>Set the team's way of working: interaction flow first, complexity later; coded prototypes to unblock product decisions; developer hand-off through artifacts built with Claude.</li>
              <li>Built the Converge design system as a React package with design tokens and governance rules for AI coding agents.</li>
              <li>Designed Key Metrics Over Time for KFC franchisees, replacing a manual Excel reporting process with a self-service report.</li>
            </ul>
          </article>

          <article class="item">
            <div class="item-head"><h3>UX Designer</h3><span class="when">Jul 2023 – Jan 2024</span></div>
            <p class="desc">CashPak · via Globant</p>
            <p class="text">Designed Pako, a digital wallet for Central America. Ran usability tests in Nicaragua and El Salvador and used the findings to localize the interface.</p>
          </article>

          <article class="item">
            <div class="item-head"><h3>Product Designer</h3><span class="when">Feb 2022 – Jun 2023</span></div>
            <p class="desc">Blackboard · via Globant</p>
            <p class="text">Redesigned communication between students and instructors (course inbox, announcements and messaging) through user research and workshops, while paying down technical debt.</p>
          </article>

          <article class="item">
            <div class="item-head"><h3>UX Lead, Colombia Aprende</h3><span class="when">Mar 2019 – Dec 2021</span></div>
            <p class="desc">Ministry of Education of Colombia</p>
            <ul class="points">
              <li>Led a team of 18: designers, developers, instructional designers, educational content managers, communicators and platform administrators.</li>
              <li>Redesigned Colombia Aprende with teachers and students into an ecosystem of 81,000 resources and 70+ microsites for about 300,000 regular users, peaking at 2.8 million during the pandemic. Content downloads grew 81% in one year.</li>
              <li>Designed Aprender Digital, an offline-first model for rural schools without internet: curated content packages that teachers carry to class as a single file. Shipped the MVP in three months; the site still draws about 1,200 visits a month from a niche audience.</li>
            </ul>
          </article>

        </div>
      </section>

      <section aria-labelledby="teaching">
        <h2 id="teaching">Teaching</h2>
        <div class="content">
          <article class="item">
            <div class="item-head"><h3>Adjunct Lecturer</h3><span class="when">2025 – present</span></div>
            <p class="desc">Universidad de Antioquia · School of Communications</p>
            <p class="text">Sensory Thinking and Interaction Design; Interactive Narratives Lab. <a href="https://catedra.dejesumensaje.com" target="_blank" rel="noopener">catedra.dejesumensaje.com</a></p>
          </article>
          <article class="item">
            <div class="item-head"><h3>Extension Instructor</h3><span class="when">2020 – present</span></div>
            <p class="desc">Universidad Nacional de Colombia</p>
            <p class="text">Digital marketing and digital skills programs for public institutions.</p>
          </article>
        </div>
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills">Skills</h2>
        <div class="content">
          <dl class="skills">
            <div><dt>Product design</dt><dd>User research · Information architecture · Interaction design · Usability testing · UX writing · Accessibility · Workshop facilitation</dd></div>
            <div><dt>Design engineering</dt><dd>Design systems · Design tokens · React component libraries · Coded prototypes · HTML, CSS and Astro</dd></div>
            <div><dt>AI</dt><dd>Claude · Claude Code · OpenCode · Kimi · Gemini · ChatGPT · Figma Make · Governance for AI coding agents</dd></div>
            <div><dt>Tools</dt><dd>Figma · Notion · Miro</dd></div>
            <div><dt>Languages</dt><dd>Spanish (native) · English (B2)</dd></div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="education">
        <h2 id="education">Education</h2>
        <div class="content">
          <article class="item">
            <div class="item-head"><h3>Graduate Specialization, Design and Social Management of Technology</h3><span class="when">2016</span></div>
            <p class="desc">Universidad de los Andes</p>
          </article>
          <article class="item">
            <div class="item-head"><h3>BA, Journalism</h3><span class="when">2009</span></div>
            <p class="desc">Universidad de Antioquia</p>
          </article>
        </div>
      </section>

    </article>
  </main>
</BaseLayout>

<style>
/* Same system as the PDF resume.
   Layout: 5-column grid. Column 1 = section labels; columns 2–5 = content.
   The four profile figures sit one per content column, so their dividers
   fall on the same column lines as everything below.
   Type: modular scale, ratio 1.2, everything in rem (print sets the root to 10pt).
   Space: 0.25rem unit in three proximity tiers (inside an item / between items / between sections). */
.resume {
  --rule: rgba(15, 15, 15, 0.12);
  --sheet: var(--white);

  /* Type scale · 1.2 */
  --t-2: 0.694rem;   /* section labels, figure labels */
  --t-1: 0.833rem;   /* org lines, dates, chips, course rows */
  --t0:  1rem;       /* body, role titles */
  --t1:  1.2rem;     /* tagline */
  --t2:  1.44rem;    /* figures */
  --t5:  2.488rem;   /* name */

  /* Space · one rule: base unit 0.25rem, tiers ×1 / ×5 / ×10
     ×1  lines inside one block (title → description → courses)
     ×5  between blocks inside a section
     ×10 between sections (the hairline sits in the middle: ×5 above, ×5 below)                                       */
  --u:  0.25rem;
  --s1: var(--u);
  --s2: calc(var(--u) * 5);
  --s3: calc(var(--u) * 10);
  --gap: 1.5rem;     /* column gap of the 5-column grid */
}

.resume * { box-sizing: border-box; }
.resume { color: var(--ink); font-family: var(--font-serif); font-size: var(--t0); line-height: 1.45; }
.resume h1, .resume h2, .resume h3, .resume dt, .when, .chip, .courses .h { font-family: var(--font-sans); }
.resume p { text-wrap: pretty; }
.resume h1, .resume h3 { text-wrap: balance; }
.resume a { color: var(--ocean); text-decoration-thickness: 1px; text-underline-offset: 3px; }
.resume a:focus-visible { outline: 2px solid var(--ocean); outline-offset: 3px; border-radius: 1px; }

/* ── Sheet & grid ── */
.sheet {
  max-width: 56rem;
  margin: 0 auto;
  background: var(--sheet);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: clamp(1.5rem, 5vw, 3.5rem);
}
.top, section {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: var(--gap);
}
.content { grid-column: 2 / -1; display: grid; gap: var(--s2); min-width: 0; }

/* ── Header ── */
.top { row-gap: var(--s1); padding-bottom: calc(var(--s3) / 2); align-items: end; }
.top h1, .top .tagline { grid-column: 1 / 5; }
.top .contact { grid-column: 5; grid-row: 1 / 3; }
.resume h1 { font-size: var(--t5); font-weight: 800; letter-spacing: -0.02em; word-spacing: 0.05em; line-height: 1.1; }
.tagline { font-style: italic; font-size: var(--t1); line-height: 1.35; }
.contact {
  display: flex; flex-direction: column; align-items: flex-end; gap: 0.1rem;
  font-family: var(--font-sans); font-size: var(--t-1); color: var(--ink-muted);
  line-height: 1.35;
}
.contact span { white-space: nowrap; }

/* ── Sections: one hairline each, label baseline-aligned with first line ── */
section {
  border-top: 1px solid var(--rule);
  padding-block: calc(var(--s3) / 2);
  align-items: baseline;
}
section:last-child { padding-bottom: 0; }
.resume h2 {
  grid-column: 1;
  font-size: var(--t-2); font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
  line-height: 1.3;
}

/* Profile figures: one per content column */
.figures {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap);
  padding-top: var(--s2);
}
.figures div { display: grid; gap: var(--s1); align-content: start; position: relative; }
.figures div + div::before {
  content: ""; position: absolute; top: 0; bottom: 0; left: calc(var(--gap) / -2);
  border-left: 1px solid var(--rule);
}
.figures dt { font-size: var(--t-2); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
.figures dd { font-family: var(--font-sans); font-weight: 700; font-size: var(--t2); letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
.figures dd small { display: block; padding-top: var(--s1); font-family: var(--font-serif); font-weight: 400; font-size: var(--t-1); letter-spacing: 0; color: var(--ink-muted); line-height: 1.3; }

/* Items */
.item { display: grid; gap: var(--s1); }
.item-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 var(--s2); }
.resume h3 { font-size: var(--t0); font-weight: 700; line-height: 1.2; }
.when { font-size: var(--t-1); color: var(--ink-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.desc { font-style: italic; font-size: var(--t-1); color: var(--ink-muted); line-height: 1.35; }

/* Course rows: same structure for every institution */
.courses { display: grid; gap: var(--s1); font-size: var(--t-1); margin-top: var(--s1); }
.courses li { display: flex; justify-content: space-between; align-items: baseline; gap: 0 var(--s2); flex-wrap: wrap; }
.courses .c { font-weight: 700; }
.courses .h { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--ink-muted); }
.courses .d { flex-basis: 100%; font-weight: 400; font-style: italic; color: var(--ink-muted); line-height: 1.35; }
.courses.detailed { gap: var(--s2); margin-top: calc(var(--s1) * 2); }
.courses.detailed li { row-gap: var(--s1); }
.text { font-size: var(--t-1); line-height: 1.4; }
/* Marketing courses: fill bleeds into the gutter so the text keeps the column edge */
.courses.focus {
  background: var(--lime); border-radius: var(--radius);
  padding: var(--s2) var(--s2);
  margin-inline: calc(var(--s2) * -1);
}
.courses.focus .h { color: var(--ink); }

.chips { display: flex; flex-wrap: wrap; gap: 0.4rem 0.35rem; }
.chip { font-size: var(--t-1); font-weight: 500; line-height: 1.2; padding: 0.3rem 0.7rem; border-radius: 2rem; border: 1px solid var(--rule); white-space: nowrap; }

@media (max-width: 720px) {
  .top h1, .top .tagline, .top .contact { grid-column: 1; grid-row: auto; }
  .contact { align-items: flex-start; }
  .top, section { grid-template-columns: 1fr; row-gap: var(--s2); }
  .resume h2, .content { grid-column: 1; }
  .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s2); }
  .figures div:nth-child(3)::before { display: none; }
  .courses.focus { margin-inline: 0; }
}

/* Achievement bullets: hanging dash, same size as .text */
.points { display: grid; gap: calc(var(--s1) * 1.5); font-size: var(--t-1); line-height: 1.4; margin-top: var(--s1); }
.points li { position: relative; padding-left: 1rem; }
.points li::before { content: "–"; position: absolute; left: 0; color: var(--ink-muted); }
/* Skills: label column + list, on the same 4-column content grid */
.skills { display: grid; gap: calc(var(--s1) * 2); font-size: var(--t-1); }
.skills div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); column-gap: var(--gap); align-items: baseline; }
.skills dt { font-family: var(--font-sans); font-weight: 700; }
.skills dd { line-height: 1.4; }
@media (max-width: 720px) { .skills div { grid-template-columns: 1fr; row-gap: var(--s1); } }

/* ── Neutralize global site typography inside the sheet (estilos.css sets
   margins, sizes and tracking on h1–h3, p, lists and .contact) ── */
.sheet h1, .sheet h2, .sheet h3 { margin: 0; color: var(--ink); }
.sheet h2, .sheet h3 { letter-spacing: normal; }
.sheet h2 { letter-spacing: 0.09em; }
.sheet p { margin: 0; max-width: none; font-size: inherit; line-height: inherit; }
.sheet .tagline { font-size: var(--t1); line-height: 1.35; }
.sheet .text { font-size: var(--t-1); line-height: 1.4; }
.sheet .desc { font-size: var(--t-1); line-height: 1.35; }
.sheet ul, .sheet dl, .sheet dd { margin: 0; padding: 0; list-style: none; }
.sheet .points li { list-style: none; margin: 0; }
.sheet .contact { max-width: none; margin: 0; }
.sheet .contact a:hover, .sheet .text a:hover { color: var(--ink); }

/* ── Page frame ── */
.resume {
  max-width: calc(56rem + var(--gutter) * 2);
  margin: 0 auto;
  padding: calc(var(--header-height) + var(--s3)) var(--gutter) var(--section-pad);
}
.resume-actions {
  display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
  gap: var(--s2); margin-bottom: var(--s2);
}
.resume-kicker {
  font-family: var(--font-sans); font-size: var(--text-micro); font-weight: 700;
  letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--ink-muted);
}
.resume-buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
.resume .sheet { background: var(--white); }
.resume .resume-buttons a { text-decoration: none; }
.resume .resume-buttons .button-cta { color: var(--white); }
.resume .resume-buttons .button-secondary { color: var(--ink); }

@media print {
  .resume { padding: 0; }
  .resume-actions { display: none; }
  .resume .sheet { border: 0; padding: 0; }
}
</style>
