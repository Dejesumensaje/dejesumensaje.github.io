---
import CaseLayout from '../layouts/CaseLayout.astro';
import CaseHeader from '../components/f/CaseHeader.astro';
import NextStory from '../components/f/NextStory.astro';
import BeforeAfter from '../components/f/BeforeAfter.astro';
import DsSpecimen from '../components/f/DsSpecimen.astro';
import DsRuleTrio from '../components/f/DsRuleTrio.astro';

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const facts = [
  { k: 'Role', v: 'Design systems engineering, token architecture, AI tooling and governance' },
  { k: 'Date', v: '2025 – ongoing' },
  { k: 'Client', v: 'Deloitte, restaurant and retail products' },
  { k: 'Design system in Figma', v: 'Grecia Gabriel and Rebecca Bradley' },
];
const overview = [
  { k: 'Challenge', v: 'We had a solid design system in Figma, but it was bypassed the moment PMs prototyped with AI tools: it lived where those tools couldn’t reach.' },
  { k: 'Contribution', v: 'React implementation of the library, token architecture, a published npm package, a component playground and the governance model for AI tooling.' },
  { k: 'Constraints', v: 'NDA-bound enterprise context. Components must render safely anywhere, and rules must be unambiguous enough for an agent to follow.' },
  { k: 'Outcome', v: 'A published npm package, a Figma Make Kit, and a portable Claude skill with a deterministic design linter. Two PMs actively use the skill, and a pricing prototype rebuilt on it went from 1,723 lint errors to none.' },
];
const skillFiles = [
  { f: 'SKILL.md', d: 'The workflow (design read, build, self-critique) and the rules that are always on: one green primary action per view, base-4 spacing, Open Sans at 400 and 600, one control per intent.' },
  { f: 'references/foundations.md', d: 'Tokens for color, charts, type and spacing.' },
  { f: 'references/components.md', d: 'The component catalog, a control matrix and the WCAG 2.2 AA requirements.' },
  { f: 'references/anti-slop.md', d: 'Visual and copy guardrails, each with a bad and a good example.' },
  { f: 'references/claude-ai-formats.md', d: 'How to build for React Artifacts, standalone HTML and Claude canvases.' },
  { f: 'kit/', d: 'The system stylesheet and a starter screen for each format.' },
  { f: 'scripts/design-lint.js', d: 'The deterministic check. Errors for spacing off the scale, colors outside the palette, native selects, table headers off the system style and broken markup. Warnings for emoji, buzzwords, fonts and gradients.' },
];
const resultNumbers = [
  { v: '1,723 → 0', k: 'design-lint errors, first prototype vs. rebuild' },
  { v: '59 → 137', k: 'screens and states covered, first prototype vs. rebuild' },
  { v: '0', k: 'steps added or removed from the flow' },
];
const ba = { labels: { before: 'First prototype', after: 'Rebuilt on the system' }, range: 'Compare the first prototype with the rebuild' };
const pairs = [
  {
    t: 'Constraints and objectives',
    b: 'Eleven constraint tabs and an objectives tab, each with paragraphs of explanation, become one list grouped by objectives, product families and other constraints, with a status on every row. Each constraint opens in a drawer, so the overview stays in place.',
    img: 'constraints',
    alt: ['First prototype: twelve constraint and objective tabs above a family table and paragraphs of explanation.', 'Rebuild: one list of constraints grouped by objectives, product families and other constraints, with a status badge on each row.'],
  },
  {
    t: 'Product families',
    b: 'Five count tiles and four native dropdowns become type tabs with counts, a search and the system’s Select. Families, constraints and strategy codes share one Settings area.',
    img: 'families',
    alt: ['First prototype: count tiles, native dropdown filters and a dense family table.', 'Rebuild: Settings with tabs, type filters with counts, a search, a category select and the family table.'],
  },
  {
    t: 'A name already in use',
    b: 'The error moves from a sentence under the form to the field itself, and Next stays disabled with its reason beside it. Zones become a checkbox list with store counts and a tri-state “All zones”, the control the skill prescribes for short multi-selects.',
    img: 'name',
    alt: ['First prototype: zone buttons and an error sentence at the bottom of the form.', 'Rebuild: the error under the name field, a disabled Next with its reason, and zones as a checkbox list with store counts.'],
  },
  {
    t: 'Editing a gap threshold',
    b: 'Paragraphs, radio cards and a reference table become one field with a % | $ segmented control and a “Required” error. Modals stay for short decisions, as the control rules ask.',
    img: 'dialog',
    alt: ['First prototype: a dialog with paragraphs, gap-type cards, an error and a reference table.', 'Rebuild: a compact dialog with one field, a percent or dollar toggle and a Required error.'],
  },
];
const states = [
  { img: 'check', a: 'Step 2 list with conflict and warning badges and a Check finished toast.', c: 'The constraint check runs in the background. Rows show conflicts and warnings, and a toast opens the details' },
  { img: 'preview', a: 'Constraints preview drawer filtered to two conflicting rules.', c: 'A read-only preview of every rule, filtered to conflicts. Each row says what is wrong' },
  { img: 'blocked', a: 'Step 3 with Run disabled and a View in step 2 link.', c: 'Run is disabled with its reason and a link to the conflict' },
  { img: 'failed', a: 'A failed scenario with its conflict and a View in setup link.', c: 'A failed run names the conflicting rule and links to it' },
  { img: 'warnings', a: 'Scenario results with two soft warnings next to All hard constraints met.', c: 'Warnings never block a run. They stay visible on the result' },
  { img: 'upload', a: 'Review upload dialog listing new rules and skipped rows.', c: 'An upload is reviewed before it applies: what is added, what is skipped and why' },
];
const decisions = [
  { t: 'Brand color is scarce', b: 'The brand green is reserved for the single most important action and its focus rings. Active and selected states use separate tokens. Encoding that in tokens lets an agent apply it without ambiguity.' },
  { t: 'Measured contrast', b: 'The warning color looked legible by eye, yet measured 2.37:1 against WCAG’s 4.5:1 threshold. Warning text now uses a darker token that passes, enforced by an automated review layer.' },
  { t: 'The system doesn’t touch what it doesn’t own', b: 'Components render in unfinished prototypes and legacy apps full of CSS, so the package never styles raw HTML globally. No bare h1, body or button selectors. Each component ships its own scoped reset.' },
  { t: 'Tokens are contracts', b: 'Token names map directly to Figma, quirks included. The designer reading the library and the engineer or agent reading the code see the same concepts. Changing a token without agreement breaks something people already built on.' },
];
---

<CaseLayout
  title="A design system for humans and AI agents — William Montoya"
  description="How I turned a design system that AI demos were bypassing into a code package, and a governance model, that humans and agents both build on."
  readFull="7 min"
  readTldr="1 min"
>
  <CaseHeader
    lead="Operationalizing a design system for"
    accent="humans and AI agents"
    question="How do you make a design system that AI tools and agents actually use, instead of approximating it?"
    facts={facts}
    overview={overview}
    readFull="7 min"
    readTldr="1 min"
  />

  <figure class="figure figure--lead wrap" data-reveal>
    <DsSpecimen label="Specimen of the design system: stepper, buttons, a name field with its error, a percent or dollar threshold, a zone checklist with store counts, status badges, the bulk-action bar and a toast." />
    <figcaption class="t-small">The system’s components, rebuilt here in HTML with its tokens</figcaption>
  </figure>


  <section class="chapter wrap" aria-labelledby="ch-problem" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-problem" class="t-h3 split__label">The problem</h2>
      <div class="prose measure split__body">
        <p>The design team already had a mature system in Figma, built by Grecia Gabriel and Rebecca Bradley.</p>
        <p>When product managers started using Claude Code and Figma Make to explore ideas with clients, each PM improvised their own interface. Demos drifted away from the system’s visual and interaction patterns, and the Figma library became a reference file those tools never touched.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-why" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-why" class="t-h3 split__label">Why a strong system wasn’t enough</h2>
      <div class="prose measure split__body">
        <p>Figma Make can bring a real design system into AI-generated prototypes through Make Kits: a component package, the tokens and styles from a Figma library, and usage guidelines, so generated screens use the real system instead of an approximation.</p>
        <p>The catch: a Make Kit can’t be built from a Figma file. It needs a published React package first. Only then can it become part of a Make Kit, and only then can guidelines be layered on top.</p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-decisions" data-reveal>
    <div class="split">
      <h2 id="ch-decisions" class="t-h3 split__label">The decisions that hold it together</h2>
      <div class="chapter__stack split__body">
        <p class="measure" data-depth="full">A package consumed by agents only works if its rules don’t depend on human judgment. A skilled designer can navigate ambiguity, while an agent follows its rules literally and fills any gap with a guess. So the rules had to be right before they were exposed.</p>
        <div class="grid2">
          {decisions.map((d) => (
            <div><h3 class="t-h3">{d.t}</h3><p class="t-muted">{d.b}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-reveal>
    <DsRuleTrio labels={{ figma: 'The Figma variables', code: 'The same tokens in the npm package', lint: 'The linter output for the first prototype and the rebuild' }} />
    <figcaption class="t-small">One rule in three places: the Figma variable, the token in the package, and the linter error when a prototype breaks it</figcaption>
  </figure>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-entry" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-entry" class="t-h3 split__label">One system, two entry points</h2>
      <div class="chapter__stack split__body">
        <div class="grid2">
          <div>
            <h3 class="t-h3">Figma Make</h3>
            <p class="t-muted">The Make Kit puts the published React components inside Figma Make, so prototypes can use the same pieces engineers ship.</p>
          </div>
          <div>
            <h3 class="t-h3">Claude Code</h3>
            <p class="t-muted">Through a CLAUDE.md with the architecture and hard rules, plus reusable skills for building, validating and documenting components. Three read-only auditors review every component in parallel: tokens, accessibility with measured contrast, and QA.</p>
          </div>
        </div>
        <p class="t-h2 pull">Generation is fast and confidently wrong. Discipline lives in a review layer with no incentive to approve its own work.</p>
      </div>
    </div>
  </section>

  <figure class="figure wrap" data-depth="full" data-reveal>
    <div class="stage" style="aspect-ratio:1296/560">
      <img class="flat" src="/assets/f/ds-sidebar.webp" width="1600" height="796" loading="lazy" alt="Sidebar component in light expanded and dark collapsed states." style={`left:${pct(248, 1296)};top:${pct(52, 560)};width:${pct(800, 1296)}`} />
    </div>
  </figure>

  <section class="chapter wrap" aria-labelledby="ch-claude" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-claude" class="t-h3 split__label">Moving directly to Claude</h2>
      <div class="prose measure split__body">
        <p>Because none of the PMs adopted Figma Make, we moved the governance directly into Claude. Instead of relying on a Make Kit bridge, teams load a portable prototyping skill that works across claude.ai React Artifacts, standalone HTML and Claude Design canvases.</p>
        <p>Collaboration stays explicit. PMs and engineers explore behavior in their own copy. When someone insists on breaking a rule, Claude builds what they asked and marks the handoff with “Design review:” naming the rule, so design catches every exception before integrating work into the main prototype.</p>
      </div>
    </div>
  </section>

  <section class="chapter wrap" aria-labelledby="ch-skill" data-depth="full" data-reveal>
    <div class="split">
      <h2 id="ch-skill" class="t-h3 split__label">Inside the skill</h2>
      <div class="chapter__stack split__body">
        <p class="measure">The skill loads only the reference a task needs.</p>
        <dl class="files">
          {skillFiles.map((s) => (
            <div><dt>{s.f}</dt><dd class="t-muted">{s.d}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight wrap" aria-labelledby="ch-result" data-reveal>
    <div class="split">
      <h2 id="ch-result" class="t-h3 split__label">Result: one prototype, before and after</h2>
      <div class="chapter__stack split__body">
        <div class="prose measure">
          <p>The prototype is a price optimization tool for a grocery retailer: teams build optimization scenarios, set the constraints prices must respect, run them and publish the result.</p>
          <p>A PM built the first prototype without the skill, then rebuilt it with the skill. I polished that second version: I cut the copy and took it through stakeholder rounds with the client. The polished version is the one the Figma hand-off documents.</p>
          <p>The linter found 1,281 colors outside the palette, 408 spacing values off the base-4 scale and 34 native selects in the first prototype. The rebuild passes with none. Both versions below render the same screen from the same preset, with mock data.</p>
        </div>
        <div class="columns3 numbers">
          {resultNumbers.map((n) => (
            <div><p class="t-h2">{n.v}</p><p class="t-muted">{n.k}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="ba-list wrap">
    {pairs.map((p) => (
      <figure class="ba-item" data-reveal>
        <div class="split">
          <h3 class="t-h3 split__label">{p.t}</h3>
          <p class="t-muted split__body ba-item__note">{p.b}</p>
        </div>
        <BeforeAfter
          before={{ src: `/assets/f/ds-pricing-${p.img}-v1.webp`, alt: p.alt[0] }}
          after={{ src: `/assets/f/ds-pricing-${p.img}-v3.webp`, alt: p.alt[1] }}
          width={1600}
          height={1138}
          labels={ba.labels}
          rangeLabel={`${ba.range}: ${p.t}`}
        />
      </figure>
    ))}
  </div>

  <section class="chapter wrap" aria-labelledby="ch-states" data-reveal>
    <div class="chapter__stack">
      <div class="split">
        <h2 id="ch-states" class="t-h3 split__label">States the first prototype didn’t have</h2>
        <p class="t-muted split__body ba-item__note">Constraints can contradict each other, so running a scenario needed states for checking, blocking, failing and warning. The check, the preview and the upload review came out of a stakeholder round.</p>
      </div>
      <ul class="shots">
        {states.map((s) => (
          <li>
            <img src={`/assets/f/ds-pricing-${s.img}.webp`} width="1600" height="1138" loading="lazy" decoding="async" alt={s.a} />
            <p class="t-small t-muted">{s.c}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="chapter chapter--section wrap" aria-labelledby="ch-outcome" data-reveal>
    <div class="split">
      <h2 id="ch-outcome" class="t-h3 split__label">Early outcomes</h2>
      <div class="prose measure split__body">
        <p>This is still an early iteration, and we are testing it with the team. Two PMs already use the Claude skill actively, compared to zero adoption on the Figma Make Kit.</p>
        <p>That contrast shaped two decisions. First, fit into the tools and workflow PMs already use instead of adding extra steps. Second, show value from the first prototype: the before-and-after above shows gains in both visual consistency and the user experience itself.</p>
      </div>
    </div>
  </section>

  <NextStory current="/design-system-ai-agents" />
</CaseLayout>
